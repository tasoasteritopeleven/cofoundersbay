{
  "name": "cofounderbay",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.14.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "predev": "node ./scripts/ensure-supported-node.cjs workspace-dev",
    "prebuild": "node ./scripts/ensure-supported-node.cjs workspace-build",
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:web": "npm run dev --prefix apps/web",
    "dev:stack": "node ./scripts/dev-stack.cjs",
    "dev:deps": "node ./scripts/ensure-dev-deps.cjs",
    "dev:api": "node ./scripts/dev-api.cjs",
    "dev:api:fast": "node ./scripts/dev-api.cjs",
    "dev:api:setup": "node ./scripts/dev-api.cjs --force-db",
    "lint": "turbo run lint",
    "clean": "turbo run clean",
    "db:generate": "npm run prisma:generate --prefix apps/api",
    "db:sync": "npm run prisma:push --prefix apps/api",
    "db:migrate": "npm run prisma:migrate --prefix apps/api",
    "db:studio": "npm run prisma:studio --prefix apps/api",
    "db:seed": "npm run db:seed --prefix apps/api",
    "preinstall": "node ./scripts/enforce-package-manager.cjs",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "devDependencies": {
    "prettier": "^3.8.1",
    "turbo": "^2.8.19",
    "typescript": "~5.9.3"
  },
  "engines": {
    "node": "^20.0.0 || ^22.0.0 || ^25.0.0"
  },
  "dependencies": {
    "@types/bcrypt": "^6.0.0",
    "bcrypt": "^6.0.0"
  },
  "license": "MIT"
}
