# CoFounderBay — copy to .env and fill values

# Database (match docker-compose or your host)
DATABASE_URL="postgresql://cofounderbay:cofounderbay_dev@localhost:5432/cofounderbay"

# Redis
REDIS_URL="redis://localhost:6379"

# Meilisearch
MEILISEARCH_HOST="http://localhost:7700"
MEILISEARCH_API_KEY="cofounderbay_meili_dev_key_change_in_prod"

# API (NestJS)
API_PORT=3001
API_URL="http://localhost:3001"
CORS_ORIGIN="http://localhost:3000"
JWT_ACCESS_SECRET="change-me-min-32-chars-for-access-token"
JWT_REFRESH_SECRET="change-me-min-32-chars-for-refresh-token"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL="7d"

# Web (Next.js) — for API base URL from browser
NEXT_PUBLIC_API_URL="http://localhost:3001"

# Web base URL (used in emails + Stripe return URLs)
WEB_BASE_URL="http://localhost:3000"

# SMTP (optional, for transactional emails)
# If SMTP_HOST/PORT/FROM are set, message notification emails will be sent via queue (Redis) when possible.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CoFounderBay <no-reply@cofounderbay.local>"

# Stripe (optional, for subscriptions / mentoring payments)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_PREMIUM=

# Optional exact host allowlist for outbound automation webhooks. Public HTTPS
# destinations remain supported when empty; private/link-local targets never are.
AUTOMATION_WEBHOOK_ALLOWED_HOSTS=

# Security — Phase 1
# Set to "true" to require email verification before login
EMAIL_VERIFICATION_REQUIRED="false"
# Frontend URL (used in verification emails)
FRONTEND_URL="http://localhost:3000"

# OAuth — Google & LinkedIn (Phase 5)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL="http://localhost:3001/api/auth/google/callback"
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_CALLBACK_URL="http://localhost:3001/api/auth/linkedin/callback"

# AWS S3 — object storage for uploads (Phase 7)
# If set, UploadsService will store files in S3 instead of local disk.
# AWS_S3_BUCKET=cofounderbay-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_ENDPOINT=               # optional: custom endpoint (e.g. Cloudflare R2, MinIO)
# AWS_CDN_URL=                   # optional: CDN base URL for serving files

# OpenAI — AI features: profile suggestions, meeting notes (Phase 8)
OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o            # default: gpt-4o

# Sentry — error tracking (Phase 7)
# Before enabling, run in apps/api:  npm install @sentry/node
# Before enabling, run in apps/web:  npm install @sentry/nextjs
# SENTRY_DSN=                    # backend DSN (from sentry.io > Project Settings > Client Keys)
# NEXT_PUBLIC_SENTRY_DSN=        # frontend DSN (same DSN value is fine for most projects)
# NEXT_PUBLIC_APP_VERSION=1.0.0  # optional: release version tag sent to Sentry

# AWS S3 / Cloudflare R2 / MinIO — object storage for file uploads (Phase 7)
# Before enabling, run in apps/api:  npm install @aws-sdk/client-s3
# If not set, uploads fall back to local disk (apps/api/uploads/)
# AWS_S3_BUCKET=cofounderbay-uploads
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=us-east-1
# AWS_S3_ENDPOINT=               # optional: custom endpoint for R2/MinIO
# AWS_CDN_URL=                   # optional: CDN base URL (e.g. https://cdn.cofounderbay.com)
