// ── Investor pipeline ──────────────────────────────────────────────────────────

/// One startup an investor is tracking.
///
/// `/investor/watchlist`, `/investor/pipeline` and `/investor/portfolio` were
/// three screens with three unrelated shapes of invented data. They are three
/// views of this one row: watching is `pipelineStage = discovered`, the board
/// groups by `pipelineStage`, and the portfolio is `pipelineStage = invested`.
/// Modelling it once is what keeps them agreeing — a deal moved to invested on
/// the board appears in the portfolio because it is the same row.
model InvestorDeal {
  id         String @id @default(uuid())
  investorId String
  investor   User   @relation("DealsByInvestor", fields: [investorId], references: [id], onDelete: Cascade)

  /// The founder on the platform, when the startup has one. Null for a deal
  /// the investor added by hand about a company that is not a member.
  founderId String?
  founder   User?   @relation("DealsOnFounder", fields: [founderId], references: [id], onDelete: SetNull)

  /// Shown as the startup's name. Kept on the row rather than read through
  /// `founder` so a deal survives the founder leaving, and so an off-platform
  /// company can be tracked at all.
  name      String
  tagline   String?
  industry  String?
  location  String?
  website   String?
  logoUrl   String?
  /// The company's own stage: idea, pre_seed, seed, series_a…
  companyStage String?
  teamSize  Int?

  /// Where it sits on the investor's board.
  pipelineStage String @default("discovered") // discovered | reviewing | meeting | due_diligence | negotiating | invested | passed

  starred       Boolean @default(false)
  alertsEnabled Boolean @default(true)
  /// The investor's private note. Never shown to the founder.
  notes         String?
  tags          String[] @default([])

  /// What they are raising, in minor units of `currency`, so no float ever
  /// touches money.
  askAmountCents Int?
  /// What was actually put in, and what it is currently held at. Both null
  /// until `pipelineStage` reaches invested.
  investedCents  Int?
  currentValueCents Int?
  currency       String @default("EUR")
  investedAt     DateTime?
  /// active | exited | written_off — meaningful only once invested.
  status         String @default("active")

  events InvestorDealEvent[]

  lastActivityAt DateTime @default(now())
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([investorId, name])
  @@index([investorId, pipelineStage])
  @@index([investorId, starred])
  @@index([founderId])
  @@index([lastActivityAt])
}

/// What happened on a deal, in order. Feeds the watchlist activity column and
/// the deal's own history, so "last activity" is a fact with a row behind it
/// rather than a string like "2 days ago" written into the page.
model InvestorDealEvent {
  id     String       @id @default(uuid())
  dealId String
  deal   InvestorDeal @relation(fields: [dealId], references: [id], onDelete: Cascade)

  /// milestone | fundraise | team | deck | update | stage_change | note
  type    String
  title   String
  body    String?
  /// Set on stage_change so the history reads as a trail, not a list.
  fromStage String?
  toStage   String?

  createdAt DateTime @default(now())

  @@index([dealId, createdAt])
}

// ── Endorsements ───────────────────────────────────────────────────────────────

model Endorsement {
  id          String   @id @default(uuid())
  fromUserId  String
  fromUser    User     @relation("EndorsementsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User     @relation("EndorsementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
  skill       String? // optional skill being endorsed (e.g., "Product Management")
  content     String   @db.Text // testimonial text
  relationship String? // e.g., "Co-founder", "Mentor", "Colleague"
  isPublic    Boolean  @default(true)
  isApproved  Boolean  @default(false) // recipient must approve before public display
  // Verified relationship behind it: 'agreement' | 'mentoring' | 'cohort' (shared evidence rules).
  basis       String[] @default([])
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([fromUserId, toUserId]) // one endorsement per pair
  @@index([toUserId, isApproved, isPublic])
  @@index([fromUserId])
  @@index([createdAt])
}

// Admin Audit Log for tracking all admin actions
model AdminAuditLog {
  id         String   @id @default(uuid())
  actorId    String
  actor      User     @relation("AdminAuditLogs", fields: [actorId], references: [id], onDelete: Cascade)
  action     String // e.g., "user.ban", "report.resolve", "content.remove"
  entityType String // e.g., "user", "report", "event", "group"
  entityId   String? // ID of the affected entity
  meta       Json? // Additional context (reason, old/new values, etc.)
  ipAddress  String?
  userAgent  String?
  createdAt  DateTime @default(now())

  @@index([actorId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Research Workspace — FigJam-like research canvas for ecosystem intelligence
// ─────────────────────────────────────────────────────────────────────────────

enum ResearchBoardCollaboratorRole {
  viewer
  editor
  admin
  owner
}

enum ResearchCommentType {
  general      // standard comment on a node
  suggestion   // proposed change
  question     // open question
  resolved     // resolved thread marker
  pin          // inline canvas pin
}

model ResearchBoard {
  id           String                   @id @default(uuid())
  ownerId      String
  owner        User                     @relation("ResearchBoardsOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  orgId        String?                  // optional org ownership
  title        String
  description  String?                  @db.Text
  visibility   ResearchBoardVisibility  @default(private)
  canvasState  Json?                    // viewport position, zoom level, etc.
  tags         String[]                 @default([])
  color        String?                  // board accent color
  icon         String?                  // board icon identifier
  isPinned     Boolean                  @default(false)
  isArchived   Boolean                  @default(false)
  createdAt    DateTime                 @default(now())
  updatedAt    DateTime                 @updatedAt

  nodes        ResearchNode[]
  connectors   ResearchConnector[]
  collaborators ResearchBoardCollaborator[]
  snapshots    ResearchBoardSnapshot[]
  canvasVersions CanvasVersion[]  @relation("CanvasVersions")
  canvasBranches CanvasBranch[]   @relation("CanvasBranches")
  canvasMerges   CanvasMerge[]    @relation("CanvasMerges")

  @@index([ownerId])
  @@index([orgId])
  @@index([visibility])
  @@index([createdAt])
}

model ResearchNode {
  id           String           @id @default(uuid())
  boardId      String
  board        ResearchBoard    @relation(fields: [boardId], references: [id], onDelete: Cascade)
  type         ResearchNodeType
  title        String?
  content      String?          @db.Text // rich text content for notes, or extracted text
  url          String?          // for links, uploaded files, or external resources
  uploadId     String?          // reference to Upload if file-based
  upload       Upload?          @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  
  // Position and size on canvas
  posX         Float            @default(0)
  posY         Float            @default(0)
  width        Float            @default(280)
  height       Float            @default(200)
  zIndex       Int              @default(0)
  
  // Styling
  color        String?          // node background/accent color
  collapsed    Boolean          @default(false)
  locked       Boolean          @default(false)
  
  // Internal entity reference (for linking to CoFounderBay entities)
  refEntityType String?         // "user", "project", "opportunity", "group", etc.
  refEntityId   String?

  // Phase 10: Cross-surface link — canvas node linked to a Builder document
  builderDocumentId String?     // optional FK to BuilderDocument
  builderDocument   BuilderDocument? @relation("NodeLinkedDocument", fields: [builderDocumentId], references: [id], onDelete: SetNull)
  
  // Metadata
  metadata     Json?            // flexible metadata (page count, dimensions, etc.)
  tags         String[]         @default([])
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  // Connectors
  connectorsFrom ResearchConnector[] @relation("ConnectorFrom")
  connectorsTo   ResearchConnector[] @relation("ConnectorTo")

  // Comments / annotations
  comments       ResearchComment[]   @relation("NodeComments")

  @@index([boardId])
  @@index([type])
  @@index([uploadId])
  @@index([builderDocumentId])
}

model ResearchConnector {
  id           String        @id @default(uuid())
  boardId      String
  board        ResearchBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  fromNodeId   String
  fromNode     ResearchNode  @relation("ConnectorFrom", fields: [fromNodeId], references: [id], onDelete: Cascade)
  toNodeId     String
  toNode       ResearchNode  @relation("ConnectorTo", fields: [toNodeId], references: [id], onDelete: Cascade)
  label        String?
  color        String?
  style        String?       @default("solid") // solid, dashed, dotted
  createdAt    DateTime      @default(now())

  @@index([boardId])
  @@index([fromNodeId])
  @@index([toNodeId])
}

model ResearchBoardCollaborator {
  id        String        @id @default(uuid())
  boardId   String
  board     ResearchBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  userId    String
  user      User          @relation("ResearchBoardCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  role      ResearchBoardCollaboratorRole @default(viewer)
  addedAt   DateTime                     @default(now())

  @@unique([boardId, userId])
  @@index([userId])
}

model ResearchComment {
  id          String              @id @default(uuid())
  nodeId      String
  node        ResearchNode        @relation("NodeComments", fields: [nodeId], references: [id], onDelete: Cascade)
  authorId    String
  author      User                @relation("ResearchComments", fields: [authorId], references: [id], onDelete: Cascade)
  body        String              @db.Text
  commentType ResearchCommentType @default(general)
  resolved    Boolean             @default(false)
  posX        Float?              // optional anchor position on the canvas
  posY        Float?

  // Threading support
  parentId    String?             // null = top-level comment
  parent      ResearchComment?    @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies     ResearchComment[]   @relation("CommentReplies")

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([nodeId])
  @@index([authorId])
  @@index([parentId])
}

model ResearchBoardSnapshot {
  id          String        @id @default(uuid())
  boardId     String
  board       ResearchBoard @relation(fields: [boardId], references: [id], onDelete: Cascade)
  createdById String
  createdBy   User          @relation("ResearchSnapshots", fields: [createdById], references: [id], onDelete: Cascade)

  label       String?       // e.g. "Before investor meeting"
  triggerType String        @default("manual") // manual | autosave | checkpoint
  nodeCount   Int           @default(0)
  nodeData    Json          // full snapshot of all nodes at time of save
  connectors  Json?         // snapshot of all connectors
  canvasState Json?         // viewport state

  createdAt   DateTime      @default(now())

  @@index([boardId])
  @@index([createdById])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Canvas Versioning System (GitHub-like for Research Canvas)
// ─────────────────────────────────────────────────────────────────────────────

enum CanvasBranchStatus {
  active
  merged
  archived
}

enum CanvasMergeStrategy {
  fast_forward
  manual
  conflict_resolved
}

enum CanvasVersionTrigger {
  manual
  autosave
  checkpoint
  pre_merge
  post_merge
  branch_create
  restore
}

/// Git-like version commit for a Research Board.
/// Linked list via parentVersionId — forms a version tree per board.
model CanvasVersion {
  id             String               @id @default(uuid())
  boardId        String
  board          ResearchBoard        @relation("CanvasVersions", fields: [boardId], references: [id], onDelete: Cascade)
  branchId       String?              // null = mainline (main branch)
  branch         CanvasBranch?        @relation("BranchVersions", fields: [branchId], references: [id], onDelete: SetNull)

  parentVersionId String?
  parent          CanvasVersion?      @relation("VersionTree", fields: [parentVersionId], references: [id], onDelete: SetNull)
  children        CanvasVersion[]     @relation("VersionTree")

  createdById    String
  createdBy      User                 @relation("CanvasVersionsAuthored", fields: [createdById], references: [id], onDelete: Cascade)

  label          String?              // human label e.g. "Before investor meeting"
  changeSummary  String?              @db.Text  // auto or manually entered summary
  triggerType    CanvasVersionTrigger @default(manual)

  // Full canvas snapshot
  nodeData       Json                 // Array<CanvasNodeSnapshot>
  connectors     Json?                // Array<CanvasConnectorSnapshot>
  canvasState    Json?                // { zoom, panX, panY }
  nodeCount      Int                  @default(0)

  // Incremental diff vs parent (null = first version or full snapshot)
  diffData       Json?                // { added[], removed[], modified[], movedNodes[], edgeDiff[] }

  // Reverse: branches that consider this version their base or head
  branchesAsBase CanvasBranch[]       @relation("BranchBase")
  branchesAsHead CanvasBranch[]       @relation("BranchHead")

  createdAt      DateTime             @default(now())

  @@index([boardId])
  @@index([branchId])
  @@index([parentVersionId])
  @@index([createdById])
  @@index([createdAt])
}

/// Named branch within a Research Board.
/// Branches are isolated canvas editing contexts derived from a base version.
model CanvasBranch {
  id              String             @id @default(uuid())
  boardId         String
  board           ResearchBoard      @relation("CanvasBranches", fields: [boardId], references: [id], onDelete: Cascade)
  name            String             // e.g. "investor-deck-experiment"
  description     String?

  baseVersionId   String?            // version this branch was forked from
  baseVersion     CanvasVersion?     @relation("BranchBase", fields: [baseVersionId], references: [id], onDelete: SetNull)

  headVersionId   String?            // latest commit on this branch
  headVersion     CanvasVersion?     @relation("BranchHead", fields: [headVersionId], references: [id], onDelete: SetNull)

  createdById     String
  createdBy       User               @relation("CanvasBranchesCreated", fields: [createdById], references: [id], onDelete: Cascade)

  status          CanvasBranchStatus @default(active)
  isDefault       Boolean            @default(false) // true for the main branch

  versions        CanvasVersion[]    @relation("BranchVersions")

  mergesAsSource  CanvasMerge[]      @relation("MergeSource")
  mergesAsTarget  CanvasMerge[]      @relation("MergeTarget")

  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([boardId, name])
  @@index([boardId])
  @@index([createdById])
  @@index([status])
}

/// Merge record — tracks when a branch was merged into another.
model CanvasMerge {
  id               String              @id @default(uuid())
  boardId          String
  board            ResearchBoard       @relation("CanvasMerges", fields: [boardId], references: [id], onDelete: Cascade)

  sourceBranchId   String
  sourceBranch     CanvasBranch        @relation("MergeSource", fields: [sourceBranchId], references: [id], onDelete: Cascade)

  targetBranchId   String
  targetBranch     CanvasBranch        @relation("MergeTarget", fields: [targetBranchId], references: [id], onDelete: Cascade)

  mergedById       String
  mergedBy         User                @relation("CanvasMergesAuthored", fields: [mergedById], references: [id], onDelete: Cascade)

  strategy         CanvasMergeStrategy @default(manual)
  conflictsJson    Json?               // Array<MergeConflict> that were detected
  resolvedJson     Json?               // Array<ConflictResolution> applied

  sourceVersionId  String?             // snapshot of source at merge time
  resultVersionId  String?             // new version created on target after merge

  createdAt        DateTime            @default(now())

  @@index([boardId])
  @@index([sourceBranchId])
  @@index([targetBranchId])
  @@index([mergedById])
}

