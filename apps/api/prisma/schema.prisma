// (FeatureFlag model defined earlier — see line ~3752)

// ─────────────────────────────────────────────────────────────────────────────
// Payment Records — Individual transaction history
// ─────────────────────────────────────────────────────────────────────────────

enum PaymentStatus {
  pending
  processing
  succeeded
  failed
  refunded
  partially_refunded
  disputed
  canceled
}

enum PaymentType {
  subscription_charge
  one_time
  addon
  refund
  credit_adjustment
  manual_charge
}

model PaymentRecord {
  id                   String         @id @default(uuid())
  subscriptionId       String?
  subscription         Subscription?  @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)
  userId               String?
  user                 User?          @relation("UserPayments", fields: [userId], references: [id], onDelete: SetNull)

  // Amount
  amountUsd            Decimal        @db.Decimal(10, 2)
  currency             String         @default("USD")
  exchangeRate         Decimal?       @db.Decimal(10, 6)

  status               PaymentStatus  @default(pending)
  paymentType          PaymentType    @default(subscription_charge)

  // Provider details
  stripePaymentIntentId String?       @unique
  stripeInvoiceId      String?
  stripeChargeId       String?

  // Invoice
  invoiceNumber        String?        @unique
  invoiceUrl           String?
  receiptUrl           String?
  description          String?

  // Refund tracking
  refundedAmount       Decimal?       @db.Decimal(10, 2)
  refundedAt           DateTime?
  refundReason         String?

  // Dispute
  disputeId            String?
  disputeStatus        String?

  failureCode          String?
  failureMessage       String?

  metadata             Json?
  paidAt               DateTime?
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  @@index([subscriptionId])
  @@index([userId])
  @@index([status])
  @@index([paymentType])
  @@index([userId, status])
  @@index([stripePaymentIntentId])
  @@index([paidAt])
  @@index([status, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Usage Tracking — For metered billing and plan limit enforcement
// ─────────────────────────────────────────────────────────────────────────────

enum UsageMetric {
  ai_credits
  api_calls
  storage_bytes
  workspaces
  team_members
  mentor_sessions
  exports
  messages
}

model UsageRecord {
  id               String        @id @default(uuid())
  userId           String?
  user             User?         @relation("UserUsageRecords", fields: [userId], references: [id], onDelete: Cascade)
  tenantId         String?

  metric           UsageMetric
  quantity         Decimal       @db.Decimal(18, 4)
  unit             String        @default("count")

  // Period
  billingPeriodStart DateTime
  billingPeriodEnd   DateTime

  // Reference
  entityType       String?       // "workspace", "message", "export", etc.
  entityId         String?

  recordedAt       DateTime      @default(now())

  @@index([userId])
  @@index([tenantId])
  @@index([metric])
  @@index([userId, metric])
  @@index([userId, metric, billingPeriodStart])
  @@index([billingPeriodStart, billingPeriodEnd])
}

// ─────────────────────────────────────────────────────────────────────────────
// Coupon / Promo Codes
// ─────────────────────────────────────────────────────────────────────────────

enum DiscountType {
  percentage
  fixed_amount
}

model PromoCode {
  id               String       @id @default(uuid())
  code             String       @unique
  description      String?

  discountType     DiscountType
  discountValue    Decimal      @db.Decimal(10, 2)  // 20 = 20% or $20

