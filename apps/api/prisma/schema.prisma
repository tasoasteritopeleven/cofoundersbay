// ── Builder Readiness Score ───────────────────────────────────────────────────
// Readiness assessment across multiple dimensions

model BuilderReadinessScore {
  id            String             @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Score data
  dimension     ReadinessDimension
  score         Int                // 0-100
  maxScore      Int                @default(100)
  
  // Criteria breakdown
  criteria      Json               // [{ id, name, completed, weight, evidence }]
  
  // Status
