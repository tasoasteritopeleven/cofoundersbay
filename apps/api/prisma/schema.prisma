  // Threading
  parentId      String?
  parent        BuilderSectionComment? @relation("SectionCommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       BuilderSectionComment[] @relation("SectionCommentReplies")
  
  // Status
  status        BuilderCommentStatus   @default(open)
  resolvedById  String?
