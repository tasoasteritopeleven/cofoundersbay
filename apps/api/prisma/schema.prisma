// ── Builder Section Comment ───────────────────────────────────────────────────
// Comments specifically on document sections

model BuilderSectionComment {
  id            String                 @id @default(uuid())
  sectionId     String
  section       BuilderDocumentSection @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  authorId      String
  author        User                   @relation("BuilderSectionCommentsAuthored", fields: [authorId], references: [id], onDelete: Cascade)
  
  // Comment content
