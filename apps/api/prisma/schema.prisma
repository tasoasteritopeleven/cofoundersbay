  // Comment content
  body          String              @db.Text
  
  // Location (for inline comments)
  sectionKey    String?             // Which section the comment is on
  anchorText    String?             // Text being commented on
  anchorStart   Int?                // Character position start
  anchorEnd     Int?                // Character position end
  
  // Threading
  parentId      String?
  parent        BuilderComment?     @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies       BuilderComment[]    @relation("CommentReplies")
  
  // Status
  status        BuilderCommentStatus @default(open)
  resolvedById  String?
  resolvedAt    DateTime?
  
  // Timestamps
