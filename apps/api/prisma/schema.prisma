  // Visibility
  isActive      Boolean                 @default(true)
  
  // Timestamps
  createdAt     DateTime                @default(now())
  updatedAt     DateTime                @updatedAt
  
  @@index([templateType])
  @@index([isActive])
}

// ── Builder Export ────────────────────────────────────────────────────────────
// Track document exports (PDF, PPTX, etc.)

model BuilderExport {
  id            String          @id @default(uuid())
  documentId    String?
  workspaceId   String?
  userId        String
  user          User            @relation("BuilderExports", fields: [userId], references: [id], onDelete: Cascade)
  
  // Export details
  format        String          // "pdf", "pptx", "docx", "json"
  fileName      String
  fileUrl       String?
  fileSizeBytes Int?
  
  // Status
  status        String          @default("pending") // "pending", "processing", "completed", "failed"
  errorMessage  String?
  
  // Timestamps
  createdAt     DateTime        @default(now())
  completedAt   DateTime?
  expiresAt     DateTime?       // When the file will be deleted
  
  @@index([userId])
  @@index([documentId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// ── Builder Activity Log ──────────────────────────────────────────────────────
// Audit trail for workspace activities

model BuilderActivityLog {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String?
  user          User?            @relation("BuilderActivities", fields: [userId], references: [id], onDelete: SetNull)
  
  // Activity details
  action        String           // "document.created", "document.edited", "comment.added", etc.
  entityType    String?          // "document", "comment", "review", etc.
  entityId      String?
  
  // Change details
  changes       Json?            // { field: { old, new } }
  metadata      Json?            // Additional context
  
  // Timestamps
  createdAt     DateTime         @default(now())
  
  @@index([workspaceId])
  @@index([userId])
  @@index([action])
  @@index([entityType])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Multi-Role / Persona System — Users can have multiple role facets
// ─────────────────────────────────────────────────────────────────────────────

model UserRoleFacet {
  id          String         @id @default(uuid())
  userId      String
  user        User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  roleType    UserRoleType
  scope       RoleFacetScope @default(global)
  scopeId     String?        // tenantId, workspaceId, communityId, programId depending on scope
  
  isActive    Boolean        @default(true)
  isPrimary   Boolean        @default(false) // Primary role for dashboard routing
  
  // Role-specific metadata
  metadata    Json?          // Additional role-specific data
  
  // Verification
  isVerified  Boolean        @default(false)
  verifiedAt  DateTime?
  verifiedBy  String?        // Admin userId who verified
  
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  
  @@unique([userId, roleType, scope, scopeId])
  @@index([userId])
  @@index([roleType])
  @@index([scope])
  @@index([isActive])
  @@index([isPrimary])
}

// ─────────────────────────────────────────────────────────────────────────────
// Organization System — Business entities (separate from Tenant for white-label)
// ─────────────────────────────────────────────────────────────────────────────

model Organization {
  id              String           @id @default(uuid())
  tenantId        String?          // Optional link to tenant for white-label
  tenant          Tenant?          @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  createdById     String
  createdBy       User             @relation("OrganizationsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Identity
  type            OrganizationType
  name            String
  slug            String           @unique
  displayName     String?
  description     String?          @db.Text
  tagline         String?
  
  // Contact & Web
  website         String?
  email           String?
  phone           String?
  
  // Branding
  logoUrl         String?
  coverImageUrl   String?
  primaryColor    String?          // Hex color
  
  // Location
  country         String?
  city            String?
  address         String?
  timezone        String?
  
  // Focus areas
  industries      String[]         @default([])
  stages          String[]         @default([]) // Startup stages they work with
  focusAreas      String[]         @default([])
  
  // Status
  isVerified      Boolean          @default(false)
  isActive        Boolean          @default(true)
  isFeatured      Boolean          @default(false)
  
  // Settings
  settings        Json?            // Organization-specific settings
  
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  
  // Relations
  memberships       OrganizationMembership[]
  programs          Program[]
  mentorPool        OrganizationMentor[]
  venturePortfolios VenturePortfolio[]
  
  @@index([type])
  @@index([slug])
  @@index([tenantId])
  @@index([isActive])
  @@index([isFeatured])
  @@index([createdAt])
}

model OrganizationMembership {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    Organization           @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  role            OrganizationMemberRole @default(member)
  title           String?                // Job title within org
  department      String?
  
  isActive        Boolean                @default(true)
  joinedAt        DateTime               @default(now())
  invitedBy       String?                // userId of inviter
  
  // Permissions override
  permissions     Json?                  // Fine-grained permissions
  
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([role])
  @@index([isActive])
}

model OrganizationMentor {
  id              String       @id @default(uuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId          String
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Mentor assignment details
  expertiseAreas  String[]     @default([])
  maxMentees      Int?
  currentMentees  Int          @default(0)
  
  isActive        Boolean      @default(true)
  assignedAt      DateTime     @default(now())
  assignedBy      String?
  
  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@index([isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Program System — Cohorts, Accelerators, Courses, Competitions
// ─────────────────────────────────────────────────────────────────────────────

model Program {
  id                  String        @id @default(uuid())
  organizationId      String
  organization        Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  tenantId            String?
  createdById         String
  createdBy           User          @relation("ProgramsCreated", fields: [createdById], references: [id], onDelete: Cascade)
  
  // Identity
  name                String
  slug                String
  description         String?       @db.Text
  shortDescription    String?
  
  // Type & Status
  programType         ProgramType
  status              ProgramStatus @default(draft)
  
  // Dates
  startDate           DateTime?
  endDate             DateTime?
  applicationDeadline DateTime?
  
  // Capacity
  capacity            Int?
  currentParticipants Int           @default(0)
  
  // Visibility
  isPublic            Boolean       @default(true)
  isFeatured          Boolean       @default(false)
  
  // Branding
  logoUrl             String?
  coverImageUrl       String?
  
  // Content
  curriculum          Json?         // Program curriculum/milestones
  requirements        Json?         // Application requirements
  benefits            Json?         // What participants get
  
  // Settings
  settings            Json?         // Program-specific settings
  
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  
  // Relations
  participants        ProgramParticipant[]
  milestones          ProgramMilestone[]
  
  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([tenantId])
  @@index([programType])
  @@index([status])
  @@index([isPublic])
  @@index([startDate])
}

model ProgramParticipant {
  id          String                   @id @default(uuid())
  programId   String
  program     Program                  @relation(fields: [programId], references: [id], onDelete: Cascade)
  userId      String?                  // Individual participant
  user        User?                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String?                  // Link to BuilderWorkspace for startup teams
  
  // Role & Status
  role        ProgramParticipantRole   @default(participant)
  status      ProgramParticipantStatus @default(applied)
  
  // Progress
  progress    Int                      @default(0) // 0-100
  score       Float?                   // Evaluation score
  rank        Int?                     // Ranking within cohort
  
  // Application
  application Json?                    // Application answers
  appliedAt   DateTime?
  acceptedAt  DateTime?
  
  // Notes
  notes       String?                  @db.Text
  feedback    Json?                    // Mentor/judge feedback
  
  joinedAt    DateTime                 @default(now())
  completedAt DateTime?
  
  @@unique([programId, userId])
  @@index([programId])
  @@index([userId])
  @@index([workspaceId])
  @@index([role])
  @@index([status])
}

model ProgramMilestone {
  id          String   @id @default(uuid())
  programId   String
  program     Program  @relation(fields: [programId], references: [id], onDelete: Cascade)
  
  title       String
  description String?  @db.Text
  dueDate     DateTime?
  sortOrder   Int      @default(0)
  
  // Requirements
  requirements Json?   // What needs to be completed
  deliverables Json?   // Expected deliverables
  
  isRequired  Boolean  @default(true)
  
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  
  @@index([programId])
  @@index([dueDate])
}

// ─────────────────────────────────────────────────────────────────────────────
// Stakeholder Profiles — Mentor, Investor, Service Provider
// ─────────────────────────────────────────────────────────────────────────────

model MentorProfile {
  id                  String                  @id @default(uuid())
  userId              String                  @unique
  user                User                    @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Professional Info
  headline            String?
  bio                 String?                 @db.Text
  expertiseSummary    String?                 @db.Text
  
  // Expertise
  industries          String[]                @default([])
  startupStages       String[]                @default([])
  skills              String[]                @default([])
  specializations     String[]                @default([])
  
  // Experience
  yearsExperience     Int?
  mentoringSince      DateTime?
  totalMentees        Int                     @default(0)
  totalSessions       Int                     @default(0)
  
  // Availability
  availabilityStatus  MentorAvailabilityStatus @default(available)
  hoursPerWeek        Int?
  sessionFormats      String[]                @default([]) // "video", "in_person", "async"
  sessionDuration     Int                     @default(30) // minutes
  timezone            String?
  
  // Pricing
  isFree              Boolean                 @default(true)
  hourlyRate          Int?                    // in cents
  currency            String                  @default("USD")
  
  // Ratings
  avgRating           Float?
  totalReviews        Int                     @default(0)
  
  // Verification
  isVerified          Boolean                 @default(false)
  verifiedAt          DateTime?
  
  // Status
  isActive            Boolean                 @default(true)
  isAcceptingRequests Boolean                 @default(true)
  
  // Settings
  preferences         Json?                   // Mentee preferences
  settings            Json?
  
  createdAt           DateTime                @default(now())
  updatedAt           DateTime                @updatedAt
  
  @@index([userId])
  @@index([availabilityStatus])
  @@index([isActive])
  @@index([isVerified])
  @@index([avgRating])
}

model InvestorProfile {
  id              String       @id @default(uuid())
  userId          String       @unique
  user            User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Investor Type
  investorType    InvestorType
  
  // Firm Info
  firmName        String?
  firmRole        String?
  firmWebsite     String?
  firmLogoUrl     String?
  
  // Investment Criteria
  checkSizeMin    Int?         // in USD
  checkSizeMax    Int?
  
  // Focus
  industries      String[]     @default([])
  stages          String[]     @default([]) // "pre-seed", "seed", "series-a"
  geographies     String[]     @default([])
  businessModels  String[]     @default([]) // "b2b", "b2c", "marketplace"
  
  // Track Record
  portfolioCount  Int?
  exitsCount      Int?
  investingSince  DateTime?
  
  // Bio
  bio             String?      @db.Text
  investmentThesis String?     @db.Text
  
  // Availability
  isActivelyScouting Boolean   @default(true)
  acceptsColdOutreach Boolean  @default(false)
  
  // Verification
  isVerified      Boolean      @default(false)
  verifiedAt      DateTime?
  
  // Status
  isActive        Boolean      @default(true)
  isPublic        Boolean      @default(true)
  
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  
  @@index([userId])
  @@index([investorType])
  @@index([isActive])
  @@index([isVerified])
  @@index([isActivelyScouting])
}

model ServiceProviderProfile {
  id              String              @id @default(uuid())
  userId          String              @unique
  user            User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Service Type
  serviceType     ServiceProviderType
  
  // Company Info
  companyName     String?
  companyWebsite  String?
  companyLogoUrl  String?
  
  // Services
  services        Json?               // [{ name, description, pricing }]
  headline        String?
  description     String?             @db.Text
  
  // Focus
  industries      String[]            @default([])
  startupStages   String[]            @default([])
  
  // Pricing
  pricingModel    String?             // "hourly", "project", "retainer", "equity"
  startingPrice   Int?                // in cents
  currency        String              @default("USD")
  
  // Track Record
  clientsServed   Int?
  yearsInBusiness Int?
  
  // Ratings
  avgRating       Float?
  totalReviews    Int                 @default(0)
  
  // Verification
  isVerified      Boolean             @default(false)
  verifiedAt      DateTime?
  
  // Status
  isActive        Boolean             @default(true)
  isAcceptingClients Boolean          @default(true)
  
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  
  @@index([userId])
  @@index([serviceType])
  @@index([isActive])
  @@index([isVerified])
}

// ─────────────────────────────────────────────────────────────────────────────
// Enhanced Mentorship System — Relationships, Sessions, Requests
// ─────────────────────────────────────────────────────────────────────────────

model MentorshipRelationship {
  id              String    @id @default(uuid())
  mentorId        String
  mentor          User      @relation("MentorshipAsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId        String
  mentee          User      @relation("MentorshipAsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  
  // Context
  workspaceId     String?   // Optional link to startup workspace
  programId       String?   // If part of a program
  organizationId  String?   // If through an organization
  
  // Status
  status          MentorshipRelationshipStatus @default(active)
  
  // Goals
  goalsJson       Json?     // Mentorship goals snapshot (legacy, see MentorshipGoal relation)
  focusAreas      String[]  @default([])
  
  // Progress
  totalSessions   Int       @default(0)
  lastSessionAt   DateTime?
  
  // Notes
  mentorNotes     String?   @db.Text
  menteeNotes     String?   @db.Text
  
  // Dates
  startedAt       DateTime  @default(now())
  endedAt         DateTime?
  nextSessionAt   DateTime?
  
  // Relations
  sessions        MentorshipSession[]
  goals           MentorshipGoal[]
  
  @@unique([mentorId, menteeId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([workspaceId])
  @@index([programId])
  @@index([status])
}

model MentorshipSession {
  id                  String               @id @default(uuid())
  relationshipId      String
  relationship        MentorshipRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  mentorId            String
  mentor              User                 @relation("SessionAsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId            String
  mentee              User                 @relation("SessionAsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  
  // Session Details
  title               String?
  description         String?              @db.Text
  
  // Scheduling
  scheduledAt         DateTime
  duration            Int                  @default(30) // minutes
  timezone            String?
  
  // Meeting
  meetingType         String               @default("video") // "video", "in_person", "phone", "chat"
  meetingUrl          String?
  meetingLocation     String?
  
  // Status
  status              String               @default("scheduled") // "scheduled", "confirmed", "in_progress", "completed", "cancelled", "no_show"
  
  // Notes
  agenda              String?              @db.Text
  mentorNotes         String?              @db.Text
  menteeNotes         String?              @db.Text
  actionItems         Json?                // [{ task, assignee, dueDate, completed }]
  
  // Feedback
  mentorRating        Int?                 // 1-5
  menteeRating        Int?                 // 1-5
  mentorFeedback      String?              @db.Text
  menteeFeedback      String?              @db.Text
  
  // Recording
  recordingUrl        String?
  transcriptUrl       String?
  
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  completedAt         DateTime?
  
  @@index([relationshipId])
  @@index([mentorId])
  @@index([menteeId])
  @@index([scheduledAt])
  @@index([status])
}

model MentorRequest {
  id              String   @id @default(uuid())
  requesterId     String
  requester       User     @relation("MentorRequestsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  mentorId        String
  mentor          User     @relation("MentorRequestsReceived", fields: [mentorId], references: [id], onDelete: Cascade)
  
  // Context
  workspaceId     String?  // Optional link to startup workspace
  programId       String?  // If through a program
  
  // Request Details
  message         String   @db.Text
  goals           String?  @db.Text
  focusAreas      String[] @default([])
  
  // Availability
  preferredFormat String?  // "video", "in_person", "async"
  preferredTimes  Json?    // Preferred meeting times
  
  // Status
  status          MentorRequestStatus @default(pending)
  
  // Response
  responseMessage String?  @db.Text
  respondedAt     DateTime?
  
  createdAt       DateTime @default(now())
  expiresAt       DateTime?
  
  @@unique([requesterId, mentorId])
  @@index([requesterId])
  @@index([mentorId])
  @@index([workspaceId])
  @@index([status])
  @@index([createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User Preferences & Matching Profile
// ─────────────────────────────────────────────────────────────────────────────

model UserPreference {
  id                    String   @id @default(uuid())
  userId                String   @unique
  user                  User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Startup Preferences
  startupStageInterest  String[] @default([]) // "idea", "validation", "mvp", "growth"
  roleInterest          String[] @default([]) // "founder", "cofounder", "advisor", "investor"
  commitmentLevel       String?  // "full_time", "part_time", "advisory", "flexible"
  
  // Work Preferences
  remotePreference      String?  // "remote", "hybrid", "onsite", "flexible"
  geographyPreference   String[] @default([])
  timezonePreference    String?
  
  // Industry & Domain
  industryPreferences   String[] @default([])
  excludedIndustries    String[] @default([])
  
  // Work Style
  workStyle             Json?    // { pace, communication, decisionMaking, etc. }
  values                String[] @default([])
  
  // Risk & Equity
  riskTolerance         String?  // "low", "medium", "high"
  equityExpectation     String?  // "none", "small", "significant", "majority"
  
  // Notification Preferences
  emailNotifications    Boolean  @default(true)
  pushNotifications     Boolean  @default(true)
  matchNotifications    Boolean  @default(true)
  messageNotifications  Boolean  @default(true)
  
  // Privacy
  profileVisibility     String   @default("public") // "public", "connections", "private"
  showInMatching        Boolean  @default(true)
  showInSearch          Boolean  @default(true)
  
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt
  
  @@index([userId])
}

model MatchProfile {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // What I'm looking for
  lookingForRoles     String[] @default([]) // "cofounder", "mentor", "investor", "advisor"
  lookingForSkills    String[] @default([])
  lookingForIndustries String[] @default([])
  
  // What I offer
  offeredRoles        String[] @default([])
  offeredSkills       String[] @default([])
  offeredExperience   String?  @db.Text
  
  // Startup context
  hasStartup          Boolean  @default(false)
  startupStage        String?
  startupIndustry     String?
  
  // Availability
  isActivelyLooking   Boolean  @default(true)
  availableFrom       DateTime?
  
  // Exclusions
  excludedConditions  String[] @default([])
  
  // Visibility
  visibilityEnabled   Boolean  @default(true)
  
  // Matching weights (user can adjust importance)
  weights             Json?    // { skills: 0.3, industry: 0.2, location: 0.2, ... }
  
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  @@index([userId])
  @@index([isActivelyLooking])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI Match Suggestions
// ─────────────────────────────────────────────────────────────────────────────

enum MatchSuggestionStatus {
  pending
  viewed
  saved
  dismissed
  connected
}

model MatchSuggestion {
  id            String                @id @default(uuid())
  sourceUserId  String
  sourceUser    User                  @relation("MatchSuggestionsAsSource", fields: [sourceUserId], references: [id], onDelete: Cascade)
  targetUserId  String
  targetUser    User                  @relation("MatchSuggestionsAsTarget", fields: [targetUserId], references: [id], onDelete: Cascade)
  
  // Scores (0-100)
  overallScore     Float
  confidenceScore  Float              @default(0.0)
  skillScore       Float              @default(0.0)
  industryScore    Float              @default(0.0)
  locationScore    Float              @default(0.0)
  stageScore       Float              @default(0.0)
  valuesScore      Float              @default(0.0)
  
  // Explanation
  reasons          String[]           @default([])
  sharedStrengths  String[]           @default([])
  frictionPoints   String[]           @default([])
  whyThisMatch     String?            @db.Text
  
  // Status
  status           MatchSuggestionStatus @default(pending)
  viewedAt         DateTime?
  savedAt          DateTime?
  dismissedAt      DateTime?
  dismissReason    String?
  
  // Meta
  algorithmVersion String?            @default("v1")
  generatedAt      DateTime           @default(now())
  expiresAt        DateTime?
  
  @@unique([sourceUserId, targetUserId])
  @@index([sourceUserId, status])
  @@index([targetUserId])
  @@index([overallScore])
  @@index([generatedAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feature Flags
// ─────────────────────────────────────────────────────────────────────────────

enum FeatureFlagScope {
  global
  tenant
  user
  role
  plan
}

model FeatureFlag {
  id           String           @id @default(uuid())
  key          String           @unique // e.g. "ai_matching_v2", "builder_financials"
  name         String
  description  String?
  scope        FeatureFlagScope @default(global)
  isEnabled    Boolean          @default(false)
  
  // Rollout percentage (0-100), null = all
  rolloutPct   Int?
  
  // Targeting
  targetRole   String?          // If scope = role
  planKeys     String[]         @default([]) // If scope = plan: ["starter", "pro"]
  enabledFor   String[]         @default([]) // explicit user/tenant ids
  
  // Metadata
  tags         String[]         @default([])
  expiresAt    DateTime?
  createdById  String?
  
  // Tenant override FK handled via TenantFeatureFlag
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt
  
  tenantOverrides TenantFeatureFlag[]

  @@index([key])
  @@index([isEnabled])
  @@index([scope])
  @@index([scope, isEnabled])
}

model TenantFeatureFlag {
  id            String      @id @default(uuid())
  tenantId      String
  tenant        Tenant      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  featureFlagId String
  featureFlag   FeatureFlag @relation(fields: [featureFlagId], references: [id], onDelete: Cascade)
  isEnabled     Boolean
  overriddenAt  DateTime    @default(now())

  @@unique([tenantId, featureFlagId])
  @@index([tenantId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Plan Tiers
// ─────────────────────────────────────────────────────────────────────────────

enum PlanBillingInterval {
  monthly
  quarterly
  annual
  lifetime
}

model PlanTier {
  id                  String              @id @default(uuid())
  key                 String              @unique // "free", "pro", "team", "enterprise"
  name                String
  tagline             String?
  description         String?             @db.Text
  
  // Pricing
  priceCents          Int                 @default(0)
  currency            String              @default("USD")
  billingInterval     PlanBillingInterval @default(monthly)
  stripePriceId       String?             @unique
  stripeProductId     String?
  
  // Limits
  maxWorkspaces       Int?                // null = unlimited
  maxTeamMembers      Int?
  maxStorageMb        Int?
  maxAiGenerations    Int?                // per month
  maxMentorSessions   Int?                // per month
  
  // Features (flags as JSON object)
  features            Json                @default("{}")
  
  // Status
  isActive            Boolean             @default(true)
  isPublic            Boolean             @default(true)
  sortOrder           Int                 @default(0)
  
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  
  @@index([isActive, isPublic])
  @@index([sortOrder])
}

// ─────────────────────────────────────────────────────────────────────────────
// Webhooks
// ─────────────────────────────────────────────────────────────────────────────

enum WebhookStatus {
  active
  paused
  failed
  revoked
}

model Webhook {
  id          String        @id @default(uuid())
  tenantId    String?
  tenant      Tenant?       @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  name        String
  url         String
  secret      String        // HMAC signing secret (hashed)
  events      String[]      @default([]) // ["user.created", "connection.accepted", ...]
  
  status      WebhookStatus @default(active)
  
  // Stats
  totalSent   Int           @default(0)
  failCount   Int           @default(0)
  lastSentAt  DateTime?
  lastErrorAt DateTime?
  lastError   String?       @db.Text
  
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  
  deliveries  WebhookDelivery[]

  @@index([tenantId])
  @@index([status])
}

model WebhookDelivery {
  id          String   @id @default(uuid())
  webhookId   String
  webhook     Webhook  @relation(fields: [webhookId], references: [id], onDelete: Cascade)
  
  eventType   String
  payload     Json
  statusCode  Int?
  response    String?  @db.Text
  duration    Int?     // ms
  
  success     Boolean  @default(false)
  sentAt      DateTime @default(now())
  
  @@index([webhookId, sentAt])
  @@index([eventType])
  @@index([success])
}

// ─────────────────────────────────────────────────────────────────────────────
// Achievements & Gamification
// ─────────────────────────────────────────────────────────────────────────────

enum AchievementCategory {
  onboarding
  matching
  collaboration
  builder
  community
  mentoring
  milestone
  program
  streak
  platform
}

model AchievementDefinition {
  id           String              @id @default(uuid())
  key          String              @unique // "first_match", "workspace_complete", etc.
  name         String
  description  String
  category     AchievementCategory
  iconUrl      String?
  points       Int                 @default(10)
  
  // Trigger condition (stored as JSON rule definition)
  condition    Json
  
  isActive     Boolean             @default(true)
  createdAt    DateTime            @default(now())
  
  userAchievements UserAchievement[]

  @@index([category])
  @@index([isActive])
}

model UserAchievement {
  id              String                @id @default(uuid())
  userId          String
  user            User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  achievementId   String
  achievement     AchievementDefinition @relation(fields: [achievementId], references: [id], onDelete: Cascade)
  
  unlockedAt      DateTime              @default(now())
  seenAt          DateTime?
  
  // Context in which it was unlocked
  contextType     String?               // "workspace", "program", "connection"
  contextId       String?

  @@unique([userId, achievementId])
  @@index([userId, unlockedAt])
  @@index([achievementId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Announcements & System Messages
// ─────────────────────────────────────────────────────────────────────────────

enum AnnouncementAudience {
  all
  founders
  mentors
  investors
  orgs
  tenant
  program
}

model Announcement {
  id          String               @id @default(uuid())
  tenantId    String?
  tenant      Tenant?              @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  
  title       String
  body        String               @db.Text
  ctaLabel    String?
  ctaUrl      String?
  
  audience    AnnouncementAudience @default(all)
  targetRole  String?
  
  // Scheduling
  startsAt    DateTime             @default(now())
  expiresAt   DateTime?
  
  isDismissable Boolean            @default(true)
  isPinned      Boolean            @default(false)
  
  createdById String?
  createdAt   DateTime             @default(now())
  
  dismissals  AnnouncementDismissal[]

  @@index([tenantId, startsAt])
  @@index([audience])
  @@index([isPinned])
}

model AnnouncementDismissal {
  userId         String
  announcementId String
  announcement   Announcement @relation(fields: [announcementId], references: [id], onDelete: Cascade)
  dismissedAt    DateTime     @default(now())

  @@id([userId, announcementId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// User Onboarding Progress
// ─────────────────────────────────────────────────────────────────────────────

model OnboardingProgress {
  id              String   @id @default(uuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  
  // Step completion flags
  profileComplete   Boolean @default(false)
  skillsAdded       Boolean @default(false)
  photoUploaded     Boolean @default(false)
  preferencesSet    Boolean @default(false)
  firstConnection   Boolean @default(false)
  firstMessage      Boolean @default(false)
  workspaceCreated  Boolean @default(false)
  firstMilestone    Boolean @default(false)
  
  // Computed
  completionPct     Int     @default(0)
  
  // Timestamps
  completedAt       DateTime?
  lastStepAt        DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([userId])
  @@index([completionPct])
}

// ─────────────────────────────────────────────────────────────────────────────
// API Keys (for external integrations)
// ─────────────────────────────────────────────────────────────────────────────

enum ApiKeyStatus {
  active
  revoked
  expired
}

model ApiKey {
  id          String       @id @default(uuid())
  tenantId    String?
  tenant      Tenant?      @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  userId      String?
  
  name        String
  keyHash     String       @unique  // SHA-256 hash of the actual key
  keyPrefix   String       // First 8 chars for display: "cfb_xxxx"
  
  scopes      String[]     @default([]) // ["read:matches", "write:workspaces", ...]
  status      ApiKeyStatus @default(active)
  
  lastUsedAt  DateTime?
  expiresAt   DateTime?
  
  createdAt   DateTime     @default(now())
  revokedAt   DateTime?

  @@index([tenantId])
  @@index([status])
  @@index([keyPrefix])
}

// ─────────────────────────────────────────────────────────────────────────────
// Fundraising — Round Tracker, Investor Pipeline, Data Room
// ─────────────────────────────────────────────────────────────────────────────

enum FundraisingRoundType {
  pre_seed
  seed
  series_a
  series_b
  series_c
  bridge
  safe
  convertible_note
  grant
  revenue_based
  other
}

enum FundraisingRoundStatus {
  planning
  active
  closing
  closed
  cancelled
}

enum InvestorLeadStatus {
  prospect
  contacted
  meeting
  due_diligence
  committed
  passed
  inactive
}

enum DataRoomDocCategory {
  pitch
  financials
  legal
  product
  market
  team
  traction
  other
}

enum DataRoomDocStatus {
  draft
  ready
  shared
  archived
}

model FundraisingRound {
  id               String                 @id @default(uuid())
  workspaceId      String?
  workspace        BuilderWorkspace?      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  ownerId          String
  owner            User                   @relation("FundraisingRoundOwner", fields: [ownerId], references: [id], onDelete: Cascade)

  name             String                 // "Seed Round", "Series A"
  roundType        FundraisingRoundType   @default(seed)
  status           FundraisingRoundStatus @default(planning)

  targetAmount     Decimal?               @db.Decimal(18, 2)
  raisedAmount     Decimal                @default(0) @db.Decimal(18, 2)
  currency         String                 @default("USD")

  preMoneyValuation Decimal?              @db.Decimal(18, 2)
  equityOffered    Decimal?               @db.Decimal(5, 4) // e.g. 0.15 = 15%

  leadInvestorName String?
  leadInvestorId   String?                // Link to platform investor profile

  closingDate      DateTime?
  announcedAt      DateTime?

  description      String?                @db.Text
  terms            Json?                  // Term sheet key points

  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt

  leads            InvestorPipelineLead[]
  documents        DataRoomDocument[]

  @@index([ownerId])
  @@index([workspaceId])
  @@index([status])
  @@index([ownerId, status])
}

model InvestorPipelineLead {
  id               String             @id @default(uuid())
  roundId          String
  round            FundraisingRound   @relation(fields: [roundId], references: [id], onDelete: Cascade)
  addedById        String
  addedBy          User               @relation("PipelineLeadsAdded", fields: [addedById], references: [id], onDelete: Cascade)

  // Investor info
  investorName     String
  investorFirm     String?
  investorEmail    String?
  investorLinkedIn String?
  investorType     String?            // "angel", "vc", "syndicate", "family_office", "scout"
  isVerifiedOnPlatform Boolean        @default(false)
  platformUserId   String?            // Link to CoFounderBay investor profile

  // Stage
  status           InvestorLeadStatus @default(prospect)
  checkSizeMin     Decimal?           @db.Decimal(18, 2)
  checkSizeMax     Decimal?           @db.Decimal(18, 2)
  committedAmount  Decimal?           @db.Decimal(18, 2)
  currency         String             @default("USD")

  // Tracking
  lastContactAt    DateTime?
  nextFollowUpAt   DateTime?
  meetingScheduledAt DateTime?
  notes            String?            @db.Text

  introducedVia    String?            // How they were introduced
  warmth           String?            // "cold", "warm", "hot"

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([roundId])
  @@index([addedById])
  @@index([roundId, status])
  @@index([status])
}

model DataRoomDocument {
  id               String              @id @default(uuid())
  roundId          String?
  round            FundraisingRound?   @relation(fields: [roundId], references: [id], onDelete: SetNull)
  workspaceId      String?
  workspace        BuilderWorkspace?   @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  uploadedById     String
  uploadedBy       User                @relation("DataRoomDocsUploaded", fields: [uploadedById], references: [id], onDelete: Cascade)

  name             String
  description      String?
  category         DataRoomDocCategory @default(other)
  status           DataRoomDocStatus   @default(draft)
  isRequired       Boolean             @default(false)

  // File
  fileUrl          String?
  fileName         String?
  fileMimeType     String?
  fileSizeBytes    Int?

  // Access control
  isPublic         Boolean             @default(false)
  sharedWithLeads  Boolean             @default(false)
  viewCount        Int                 @default(0)

  version          Int                 @default(1)
  notes            String?             @db.Text

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  accessLogs       DataRoomAccessLog[]

  @@index([roundId])
  @@index([workspaceId])
  @@index([uploadedById])
  @@index([roundId, category])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Coaching Sessions (distinct from Mentoring — process-oriented accountability)
// ─────────────────────────────────────────────────────────────────────────────

enum CoachingSessionStatus {
  scheduled
  confirmed
  in_progress
  completed
  cancelled
  no_show
}

enum CoachingSessionType {
  accountability
  clarity
  team_dynamics
  execution
  strategy
  wellbeing
  other
}

model CoachingSession {
  id              String               @id @default(uuid())
  coachId         String
  coach           User                 @relation("CoachingSessions_Coach", fields: [coachId], references: [id], onDelete: Cascade)
  clientId        String
  client          User                 @relation("CoachingSessions_Client", fields: [clientId], references: [id], onDelete: Cascade)

  workspaceId     String?              // Optional workspace context
  programId       String?              // If part of org program

  sessionType     CoachingSessionType  @default(accountability)
  title           String?
  agenda          String?              @db.Text

  scheduledAt     DateTime
  durationMinutes Int                  @default(45)
  timezone        String?

  meetingUrl      String?
  meetingLocation String?

  status          CoachingSessionStatus @default(scheduled)

  // Session notes
  coachNotes      String?              @db.Text
  clientNotes     String?              @db.Text
  actionItems     Json?                // [{ task, owner, dueDate, done }]
  keyInsights     String?              @db.Text

  // Feedback
  coachRating     Int?                 // 1–5
  clientRating    Int?                 // 1–5
  coachFeedback   String?              @db.Text
  clientFeedback  String?              @db.Text

  // Next session
  nextSessionAt   DateTime?
  followUpNotes   String?              @db.Text

  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  completedAt     DateTime?

  @@index([coachId])
  @@index([clientId])
  @@index([scheduledAt])
  @@index([status])
  @@index([coachId, status])
  @@index([clientId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Expert / Advisor Reviews (domain-specific structured feedback)
// ─────────────────────────────────────────────────────────────────────────────

enum ExpertReviewStatus {
  requested
  accepted
  in_progress
  submitted
  declined
  expired
}

enum ExpertReviewType {
  pitch_deck
  business_model
  financial_model
  legal_structure
  market_analysis
  go_to_market
  technical_architecture
  product_strategy
  general
}

model ExpertReview {
  id               String            @id @default(uuid())
  requesterId      String
  requester        User              @relation("ExpertReviews_Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  expertId         String
  expert           User              @relation("ExpertReviews_Expert", fields: [expertId], references: [id], onDelete: Cascade)

  workspaceId      String?           // Workspace/startup context

  reviewType       ExpertReviewType  @default(general)
  status           ExpertReviewStatus @default(requested)

  // Request
  requestMessage   String?           @db.Text
  documentsJson    Json?             // List of documents/URLs shared

  // Review output
  summaryFeedback  String?           @db.Text
  strengthsJson    Json?             // [{ area, comment }]
  improvementsJson Json?             // [{ area, recommendation }]
  scoreOverall     Int?              // 1–10
  scoresByArea     Json?             // { "market": 7, "team": 9, ... }

  // Compensation
  isPaid           Boolean           @default(false)
  agreedFee        Decimal?          @db.Decimal(10, 2)
  currency         String            @default("USD")

  // Timing
  requestedAt      DateTime          @default(now())
  acceptedAt       DateTime?
  dueDate          DateTime?
  submittedAt       DateTime?
  
  rating           Int?              // Requester rates review 1-5
  ratingComment    String?           @db.Text

  @@index([requesterId])
  @@index([expertId])
  @@index([workspaceId])
  @@index([status])
  @@index([reviewType, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Service Offers & Inquiries (Marketplace — structured provider offerings)
// ─────────────────────────────────────────────────────────────────────────────

enum ServiceOfferStatus {
  draft
  active
  paused
  archived
}

enum ServicePricingModel {
  fixed
  hourly
  monthly_retainer
  project_based
  equity
  free
  contact_for_pricing
}

enum ServiceInquiryStatus {
  open
  in_discussion
  accepted
  declined
  completed
  cancelled
}

model ServiceOffer {
  id                String             @id @default(uuid())
  providerId        String
  provider          User               @relation("ServiceOffers_Provider", fields: [providerId], references: [id], onDelete: Cascade)

  title             String
  description       String             @db.Text
  shortTagline      String?

  category          String             // "legal", "finance", "design", "dev", "marketing", "strategy", etc.
  subcategory       String?
  tags              String[]           @default([])

  pricingModel      ServicePricingModel @default(contact_for_pricing)
  priceFrom         Decimal?           @db.Decimal(10, 2)
  priceTo           Decimal?           @db.Decimal(10, 2)
  currency          String             @default("USD")
  pricingNotes      String?

  deliverables      Json?              // [{ item, description }]
  deliveryDays      Int?
  revisionsIncluded Int?

  // Targeting
  targetStartupStages String[]         @default([])  // "idea", "mvp", "growth"
  targetIndustries    String[]         @default([])

  // Credibility
  portfolioUrls     String[]           @default([])
  testimonialsJson  Json?              // [{ name, role, comment, rating }]
  completedProjects Int                @default(0)

  status            ServiceOfferStatus @default(draft)
  isFeatured        Boolean            @default(false)
  viewCount         Int                @default(0)
  inquiryCount      Int                @default(0)
  avgRating         Decimal?           @db.Decimal(3, 2)
  reviewCount       Int                @default(0)

  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  inquiries         ServiceInquiry[]

  @@index([providerId])
  @@index([status])
  @@index([category])
  @@index([isFeatured])
  @@index([providerId, status])
}

model ServiceInquiry {
  id               String              @id @default(uuid())
  offerId          String
  offer            ServiceOffer        @relation(fields: [offerId], references: [id], onDelete: Cascade)
  clientId         String
  client           User                @relation("ServiceInquiries_Client", fields: [clientId], references: [id], onDelete: Cascade)
  providerId       String
  provider         User                @relation("ServiceInquiries_Provider", fields: [providerId], references: [id], onDelete: Cascade)

  workspaceId      String?
  status           ServiceInquiryStatus @default(open)

  message          String              @db.Text
  budgetEstimate   Decimal?            @db.Decimal(10, 2)
  currency         String              @default("USD")
  timelineExpected String?

  // Response
  responseMessage  String?             @db.Text
  agreedScope      String?             @db.Text
  agreedPrice      Decimal?            @db.Decimal(10, 2)

  // Outcome
  rating           Int?                // 1–5
  reviewComment    String?             @db.Text

  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt
  resolvedAt       DateTime?

  @@index([offerId])
  @@index([clientId])
  @@index([providerId])
  @@index([status])
  @@index([providerId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
