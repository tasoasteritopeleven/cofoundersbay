  rating        Int?                // 1-5 rating
  
  // Timestamps
  requestedAt   DateTime            @default(now())
  dueDate       DateTime?
  completedAt   DateTime?
  
  @@index([documentId])
  @@index([requestedById])
  @@index([reviewerId])
