// ─────────────────────────────────────────────────────────────────────────────
// AI Conversation System — Persistent AI chat history and preferences
// ─────────────────────────────────────────────────────────────────────────────

enum AIAgentType {
  general
  matching
  research
  pitch_coach
  mentor_finder
  market_analyst
  fundraising
  legal_advisor
  technical_advisor
  growth_strategist
}

model AIConversation {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("AIConversations", fields: [userId], references: [id], onDelete: Cascade)

  agentType AIAgentType @default(general)
  title     String?     @db.VarChar(255)
  summary   String?     @db.Text

  // Context metadata for the conversation
  contextType  String?  // "profile", "startup", "pitch", "match", etc.
  contextId    String?  // ID of the related entity
  contextData  Json?    // Additional context passed to the AI

  // Conversation state
  messageCount Int      @default(0)
  tokenCount   Int      @default(0)
  isArchived   Boolean  @default(false)
  isPinned     Boolean  @default(false)

  // Feedback & quality
  rating       Int?     // 1-5 star rating
  feedback     String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  lastMessageAt DateTime?

  messages AIMessage[]

  @@index([userId])
  @@index([userId, agentType])
  @@index([userId, isArchived])
  @@index([userId, lastMessageAt])
  @@index([contextType, contextId])
}

model AIMessage {
  id             String   @id @default(uuid())
  conversationId String
  conversation   AIConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  role    AIMessageRole
  content String        @db.Text

  // Token usage tracking
  promptTokens     Int?
  completionTokens Int?
  totalTokens      Int?

  // Model info
  model     String?  @db.VarChar(100)
  provider  String?  @db.VarChar(50) // "ollama", "openai", "anthropic"

  // Response metadata
  responseTimeMs Int?
  isStreamed     Boolean @default(false)
  isFallback     Boolean @default(false) // True if AI was unavailable

  // Error tracking
  errorCode    String?  @db.VarChar(50)
  errorMessage String?  @db.Text

  createdAt DateTime @default(now())

  @@index([conversationId])
  @@index([conversationId, createdAt])
  @@index([role])
}

// ─────────────────────────────────────────────────────────────────────────────
// AI User Preferences — Per-user AI customization settings
// ─────────────────────────────────────────────────────────────────────────────

model AIUserPreference {
  id     String @id @default(uuid())
  userId String @unique
  user   User   @relation("AIPreferences", fields: [userId], references: [id], onDelete: Cascade)

  // Model preferences
  preferredModel    String?  @db.VarChar(100) // "llama3.2", "mistral", etc.
  preferredProvider String?  @db.VarChar(50)  // "ollama", "openai"
  temperature       Float?   @default(0.7)
  maxTokens         Int?     @default(2048)

  // Response style preferences
  responseStyle     String?  @db.VarChar(50) // "concise", "detailed", "casual", "formal"
  responseLanguage  String?  @db.VarChar(10) @default("en")
  useEmoji          Boolean  @default(false)

  // Feature toggles
  enableStreaming     Boolean @default(true)
  enableSuggestions   Boolean @default(true)
  enableContextMemory Boolean @default(true)
  enableAutoSave      Boolean @default(true)

  // Privacy settings
  saveConversations  Boolean @default(true)
  shareForTraining   Boolean @default(false)
  anonymizeData      Boolean @default(true)

  // Default agent for different contexts
  defaultAgent       AIAgentType @default(general)
  matchingAgent      AIAgentType @default(matching)
  pitchAgent         AIAgentType @default(pitch_coach)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

