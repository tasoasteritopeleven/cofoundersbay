// ─────────────────────────────────────────────────────────────────────────────
// AI Usage Analytics — Track AI feature usage for optimization
// ─────────────────────────────────────────────────────────────────────────────

model AIUsageLog {
  id        String   @id @default(uuid())
  userId    String?
  tenantId  String?

