// ── Builder Workspace ─────────────────────────────────────────────────────────
// Central hub for a startup's formation documents and collaboration

model BuilderWorkspace {
  id          String                    @id @default(uuid())
  ownerId     String
  owner       User                      @relation("BuilderWorkspacesOwned", fields: [ownerId], references: [id], onDelete: Cascade)
  tenantId    String?                   // Optional organization/tenant ownership
  
  // Basic info
  name        String
  slug        String                    @unique
  description String?                   @db.Text
  logoUrl     String?
  
  // Status & visibility
  status      BuilderWorkspaceStatus    @default(draft)
  visibility  BuilderWorkspaceVisibility @default(private)
  
  // Startup metadata
  startupName     String?
  industry        String?
  stage           String?               // "idea", "validation", "mvp", "growth", "scale"
  targetMarket    String?
  foundingDate    DateTime?
  
  // Settings
  settings        Json?                 // { aiProvider, defaultLanguage, exportFormat, etc. }
  
  // Timestamps
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt
  archivedAt  DateTime?
  
  // Relations
  documents       BuilderDocument[]
  collaborators   BuilderCollaborator[]
  readinessScores BuilderReadinessScore[]
  aiGenerations   BuilderAIGeneration[]
  versions        BuilderWorkspaceVersion[]
  applications    BuilderApplication[]
  activityLogs    BuilderActivityLog[]

  // Extended relations
  fundraisingRounds    FundraisingRound[]
  dataRoomDocuments    DataRoomDocument[]
  startupSnapshot      StartupSnapshot?
  techArchitecture     TechArchitecture?
  productRequirements  ProductRequirementDoc[]
  venturePortfolio     VenturePortfolio?       @relation("VenturePortfolioWorkspace")
  startupApplications  StartupApplication[]    @relation("WorkspaceApplications")
  workspaceComments    WorkspaceComment[]      @relation("WorkspaceComments")

  // Phase 1 — Collaboration Architecture relations
  workspaceShareLinks  ArtifactShareLink[]     @relation("WorkspaceShareLinks")

  // Gamification Engine
  contributionScores      ContributionScore[]         @relation("WorkspaceContributionScores")
  teamMomentumScore       TeamMomentumScore?          @relation("WorkspaceTeamMomentum")
  mentorFeedbackMetric    MentorFeedbackMetric?       @relation("WorkspaceMentorMetrics")
  gamificationReadiness   GamificationReadinessScore? @relation("WorkspaceGamificationReadiness")

  @@index([ownerId])
  @@index([tenantId])
  @@index([status])
  @@index([visibility])
  @@index([slug])
  @@index([createdAt])
}

// ── Builder Document ──────────────────────────────────────────────────────────
// Individual documents within a workspace (BMC, Pitch Deck, etc.)

model BuilderDocument {
  id            String                @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace      @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  
  // Document identity
  type          BuilderDocumentType
  title         String
  description   String?               @db.Text
  
  // Content (JSON structure varies by document type)
  content       Json                  // Full document content
  contentSchema String?               // Schema version for content structure
  
  // Status & metadata
  status        BuilderDocumentStatus @default(draft)
  completionPercent Int               @default(0)
  lastEditedById String?
  
  // AI generation tracking
  aiGenerated   Boolean               @default(false)
  aiModel       String?               // "gpt-4", "claude-3", etc.
  aiPromptHash  String?               // Hash of prompt used for generation
  
  // Versioning
  version       Int                   @default(1)
  isLatest      Boolean               @default(true)
  parentId      String?               // Previous version reference
  
  // Timestamps
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  publishedAt   DateTime?
  
  // Relations
  comments      BuilderComment[]
  reviews       BuilderReview[]
  versions      BuilderDocumentVersion[]
  sections      BuilderDocumentSection[]

  // Phase 1 — Collaboration Architecture relations
  branches      ArtifactBranch[]     @relation("DocumentBranches")
  shareLinks    ArtifactShareLink[]  @relation("DocumentShareLinks")
  crdtStates    CRDTSyncState[]      @relation("DocumentCRDTState")

  // Phase 10 — Cross-surface canvas links
  linkedResearchNodes ResearchNode[] @relation("NodeLinkedDocument")
  
  @@index([workspaceId])
  @@index([type])
  @@index([status])
  @@index([isLatest])
  @@index([createdAt])
}

// ── Builder Document Section ──────────────────────────────────────────────────
// Granular sections within a document for targeted editing and commenting

model BuilderDocumentSection {
  id            String          @id @default(uuid())
  documentId    String
  document      BuilderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Section identity
  sectionKey    String          // e.g., "value_propositions", "customer_segments", "slide_1"
  sectionTitle  String
  sortOrder     Int             @default(0)
  
  // Content
  content       Json            // Section-specific content
  
  // Status
  isComplete    Boolean         @default(false)
  confidence    Int?            // 0-100 confidence score
  
  // AI metadata
  aiGenerated   Boolean         @default(false)
  aiSuggestions Json?           // AI-suggested improvements
  
  // Timestamps
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  
  // Relations
  comments      BuilderSectionComment[]
  
  @@unique([documentId, sectionKey])
  @@index([documentId])
  @@index([sectionKey])
}

// ── Builder Document Version ──────────────────────────────────────────────────
// Version history for documents

model BuilderDocumentVersion {
  id            String          @id @default(uuid())
  documentId    String
  document      BuilderDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Version info
  version       Int
  versionLabel  String?         // "v1.0", "Draft 2", "Final", etc.
  
  // Content snapshot
  content       Json
  
  // Change tracking
  changesSummary String?        @db.Text
  changedById   String?
  
  // Timestamps
  createdAt     DateTime        @default(now())
  
  @@unique([documentId, version])
  @@index([documentId])
  @@index([createdAt])
}

