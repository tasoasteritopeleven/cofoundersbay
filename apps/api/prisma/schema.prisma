// ─────────────────────────────────────────────────────────────────────────────
// Saved Search — User's saved search queries and filters
// ─────────────────────────────────────────────────────────────────────────────

enum SavedSearchType {
  cofounder
  mentor
  investor
  startup
  opportunity
  program
  community
  member
  job
}

/// A listing or a job a member saved to come back to (LinkedIn's "Save").
/// Private to the member; the title is copied from the source on save.
/// Schema-only like the other October 2026 models: `prisma db push`.
model SavedItem {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation("SavedItems", fields: [userId], references: [id], onDelete: Cascade)
  kind      String // 'opportunity' | 'job' (packages/shared saved-items)
  itemId    String
  title     String
  createdAt DateTime @default(now())

  @@unique([userId, kind, itemId])
  @@index([userId, createdAt])
}

model SavedSearch {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("SavedSearches", fields: [userId], references: [id], onDelete: Cascade)

  name          String
  searchType    SavedSearchType
  
  // Search parameters stored as JSON
  query         String?         // text query
  filters       Json            // { industries: [], skills: [], stages: [], locations: [], etc. }
  sortBy        String?
  sortOrder     String?         @default("desc")

  // Alert settings
  alertEnabled  Boolean         @default(false)
  alertFrequency String?        @default("daily") // "instant", "daily", "weekly"
  lastAlertAt   DateTime?

  // Usage tracking
  useCount      Int             @default(0)
  lastUsedAt    DateTime?
  lastResultCount Int?
  // Profiles the owner has already been shown, so an alert names only new ones
  seenResultIds String[]        @default([])
  // Announced by alerts since the owner last ran the search ("N new" on /saved-searches)
  pendingNewCount Int           @default(0)

  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@index([userId])
  @@index([userId, searchType])
  @@index([alertEnabled, lastAlertAt])
}

// ─────────────────────────────────────────────────────────────────────────────
