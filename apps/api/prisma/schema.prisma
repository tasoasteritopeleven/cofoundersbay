enum ApplicationStatus {
  draft
  submitted
  under_review
  shortlisted
  accepted
  rejected
  withdrawn
}

model StartupApplication {
  id               String             @id @default(uuid())
  applicantId      String
  applicant        User               @relation("ApplicationsSubmitted", fields: [applicantId], references: [id], onDelete: Cascade)
  workspaceId      String?
  workspace        BuilderWorkspace?  @relation("WorkspaceApplications", fields: [workspaceId], references: [id], onDelete: SetNull)

  // Target
  programId        String?
  tenantId         String?
  externalUrl      String?            // For external program applications

  programName      String?            // Denormalized for display
  organizationName String?

  status           ApplicationStatus  @default(draft)

  // Application content
  coverLetter      String?            @db.Text
  answersJson      Json?              // { questionId: answer }
  attachmentsJson  Json?              // [{ name, url, type }]

  // Review
  reviewScore      Int?               // 1-100
  reviewNotes      String?            @db.Text
  reviewedById     String?
  reviewedAt       DateTime?

  submittedAt      DateTime?
  decidedAt        DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([applicantId])
  @@index([workspaceId])
  @@index([programId])
  @@index([tenantId])
  @@index([status])
  @@index([applicantId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
