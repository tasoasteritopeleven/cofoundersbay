  userId        String
  user          User                    @relation("BuilderCollaborations", fields: [userId], references: [id], onDelete: Cascade)
  
  // Role & permissions
  role          BuilderCollaboratorRole @default(viewer)
  permissions   Json?                   // Fine-grained permissions override
  
  // Status
  isActive      Boolean                 @default(true)
  invitedById   String?
  invitedAt     DateTime                @default(now())
  acceptedAt    DateTime?
  lastAccessAt  DateTime?
  
  // Notification preferences
  notifyOnComments Boolean              @default(true)
  notifyOnChanges  Boolean              @default(false)
  notifyOnReviews  Boolean              @default(true)
  
  @@unique([workspaceId, userId])
  @@index([workspaceId])
  @@index([userId])
  @@index([role])
