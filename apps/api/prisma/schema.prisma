enum AutomationTriggerType {
  user_signup
  onboarding_incomplete
  profile_incomplete
  match_generated
  match_not_viewed
  connection_request_sent
  connection_not_answered
  connection_accepted
  mentor_request_submitted
  mentor_request_accepted
  mentor_session_idle
  community_join
  community_inactive
  content_reported_threshold
  tenant_setup_incomplete
  subscription_trial_ending
  subscription_failed_payment
  subscription_canceled
  subscription_seat_limit
  user_inactive
  scheduled
  manual
}

enum AutomationActionType {
  send_email
  send_in_app_notification
  generate_matches
  flag_for_admin_review
  send_admin_alert
  update_user_field
  trigger_another_rule
  log_event
  webhook_call
}

enum AutomationStatus {
  draft
  active
  paused
  archived
}

enum AutomationExecutionStatus {
  pending
  running
  completed
  failed
  skipped
  cancelled
}

enum ScheduledJobStatus {
  pending
  processing
  completed
  failed
  cancelled
}

model AutomationRule {
  id       String  @id @default(uuid())
  tenantId String? // null = global platform rule
  tenant   Tenant? @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  name               String
  description        String?               @db.Text
  triggerType        AutomationTriggerType
  conditionDef       Json? // [{ field, operator, value }]
  actionDef          Json // { type, params }
  delaySeconds       Int                   @default(0)
  scheduleExpression String? // cron expression for scheduled triggers

  status   AutomationStatus @default(draft)
  priority Int              @default(100)

  executionCount Int       @default(0)
  lastRunAt      DateTime?
  nextRunAt      DateTime?
  failureCount   Int       @default(0)
  maxFailures    Int       @default(10)

  createdBy String? // userId
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  executions AutomationExecution[]

  @@index([tenantId])
  @@index([triggerType])
  @@index([status])
  @@index([nextRunAt])
}

model AutomationExecution {
  id     String         @id @default(uuid())
  ruleId String
  rule   AutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  targetUserId     String?
  targetEntityType String? // "user", "tenant", "connection", etc.
  targetEntityId   String?

  status      AutomationExecutionStatus @default(pending)
  scheduledAt DateTime?
  startedAt   DateTime?
  completedAt DateTime?

  result       Json?
  errorMessage String? @db.Text
  retryCount   Int     @default(0)

  createdAt DateTime @default(now())

  logs AutomationLog[]

  @@index([ruleId])
  @@index([targetUserId])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model AutomationLog {
  id          String              @id @default(uuid())
  executionId String
  execution   AutomationExecution @relation(fields: [executionId], references: [id], onDelete: Cascade)

  level   String // "info", "warn", "error"
  message String @db.Text
  context Json?

  createdAt DateTime @default(now())

  @@index([executionId])
  @@index([level])
  @@index([createdAt])
}

model ScheduledJob {
  id      String @id @default(uuid())
  type    String // job type identifier
  payload Json?

  status      ScheduledJobStatus @default(pending)
  runAt       DateTime
  startedAt   DateTime?
  completedAt DateTime?

  retryCount   Int     @default(0)
  maxRetries   Int     @default(3)
  errorMessage String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([type])
  @@index([status])
  @@index([runAt])
}

model NotificationTemplate {
  id       String  @id @default(uuid())
  tenantId String? // null = global
  key      String  @unique // e.g. "onboarding_reminder", "match_nudge"
  name     String
  type     String // "email", "in_app", "both"

  subject   String? // for email
  bodyHtml  String? @db.Text
  bodyText  String? @db.Text
  variables Json? // expected template variable names

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([key])
  @@index([tenantId])
  @@index([type])
}

model TenantAutomationConfig {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  automationsEnabled     Boolean @default(true)
  maxEmailsPerUserPerDay Int     @default(3)
  maxNotificationsPerDay Int     @default(10)
  quietHoursStart        Int? // 0-23 hour
  quietHoursEnd          Int? // 0-23 hour
  timezone               String  @default("UTC")

  onboardingAutomation   Boolean @default(true)
  matchingAutomation     Boolean @default(true)
  mentorshipAutomation   Boolean @default(true)
  communityAutomation    Boolean @default(true)
  billingAutomation      Boolean @default(true)
  reEngagementAutomation Boolean @default(false)

  updatedAt DateTime @updatedAt

  @@index([tenantId])
}

