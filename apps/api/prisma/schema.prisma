// CoFounderBay — source of truth
// https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  founder
  mentor
  investor
  org
  admin
  super_admin
}

// ── Multi-Role / Persona System ────────────────────────────────────────────────
// A user can have multiple role facets simultaneously (e.g., founder + mentor)

enum UserRoleType {
  aspiring_founder
  existing_founder
  cofounder_candidate
  technical_talent
  business_operator
  mentor
  advisor
  coach
  course_creator
  incubator_admin
  accelerator_admin
  university_admin
  venture_studio_admin
  angel_investor
  vc_scout
  vc_analyst
  syndicate_manager
  service_provider
  legal_partner
  finance_advisor
  recruiter
  platform_admin
}

enum RoleFacetScope {
  global
  tenant
  workspace
  community
  program
}

enum OrganizationType {
  incubator
  accelerator
  university
  venture_studio
  innovation_hub
  vc_fund
  angel_syndicate
  public_body
  service_provider
  corporate_innovation
  chamber
  cluster
  ngo
}

enum OrganizationMemberRole {
  owner
  admin
  program_manager
  mentor
  reviewer
  member
}

enum ProgramType {
  accelerator
  incubator
  course
  competition
  grant
  challenge
  bootcamp
  fellowship
}

enum ProgramStatus {
  draft
  upcoming
  active
  completed
  archived
}

enum ProgramParticipantRole {
  participant
  mentor
  judge
  organizer
  reviewer
  observer
}

enum ProgramParticipantStatus {
  applied
  accepted
  active
  completed
  dropped
  rejected
}

enum MentorAvailabilityStatus {
  available
  limited
  unavailable
  by_invitation
}

enum InvestorType {
  angel
  vc
  scout
  syndicate
  cvc
  family_office
  institutional
}

enum ServiceProviderType {
  legal
  accounting
  development
  design
  marketing
  recruiting
  consulting
  coaching
}

enum ConversationType {
  direct
  group
}

enum ConversationValidationMode {
  casual
  one_party
  two_party
}

enum UploadKind {
  avatar
  message_attachment
  event_attachment
  research_asset
}

enum ResearchNodeType {
  note
  document
  image
  pdf
  link
  reference // internal CoFounderBay entity reference
}

enum ResearchBoardVisibility {
  private
  team
  organization
  public
}

enum EventType {
  meetup
  webinar
  workshop
  demo_day
  networking
  other
}

enum RsvpStatus {
  going
  interested
  not_going
}

enum MeetingType {
  video
  in_person
  chat
}

enum BookingStatus {
  requested
  confirmed
  cancelled
  completed
}

enum NotificationType {
  message
  connection_request
  connection_accepted
  event_rsvp
  system
  billing
  mentor_request
  mentor_session_reminder
  mentor_review_received
  match_suggestion
  endorsement_received
  endorsement_request
  workspace_comment
  workspace_review
  workspace_invite
  program_application
  program_accepted
  program_rejected
  milestone_due
  milestone_completed
  group_invite
  group_post
  referral_converted
  follow_new
  ai_generation_complete
  expert_review_submitted
  coaching_session_reminder
  fundraising_update
  commitment_update
  founder_update
  intro_request
}

enum ConnectionStatus {
  pending
  accepted
  declined
  blocked
}

enum ReportType {
  spam
  harassment
  fake
  inappropriate
  other
}

enum ReportStatus {
  pending
  reviewed
  resolved
  dismissed
}

enum SubscriptionStatus {
  trialing
  active
  past_due
  paused
  canceled
  unpaid
  incomplete
  incomplete_expired
}

enum UserModerationStatus {
  active
  suspended
  banned
}

enum InviteStatus {
  pending
  accepted
  expired
  cancelled
}

enum GroupPrivacy {
  public
  private
  secret
}

enum GroupMemberRole {
  owner
  admin
  moderator
  member
}

enum TenantMemberRole {
  owner
  admin
  manager
  member
}

enum MentorshipRelationshipStatus {
  pending
  active
  paused
  completed
  terminated
}

enum MentorRequestStatus {
  pending
  accepted
  declined
  expired
  cancelled
}

enum WatchlistItemStatus {
  watching
  in_pipeline
  passed
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  slug                     String               @unique
  passwordHash             String?
  role                     Role                 @default(founder)
  moderationStatus         UserModerationStatus @default(active)
  emailVerified            Boolean              @default(false)
  emailVerificationToken   String?              @unique
  emailVerificationExpires DateTime?
  passwordResetToken       String?              @unique
  passwordResetExpires     DateTime?
  hasCompletedOnboarding   Boolean              @default(false)
  lastSeenAt               DateTime?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt

  refreshTokens RefreshToken[]
  profile       Profile?

  // OAuth providers
  googleId   String? @unique
  linkedinId String? @unique

  // Two-Factor Authentication
  twoFactorSecret      String?
  twoFactorEnabled     Boolean  @default(false)
  twoFactorBackupCodes String[] @default([])

  // Messaging
  conversationParticipants ConversationParticipant[]
  messagesSent             Message[]
  validationsInitiated     ConversationValidation[]  @relation("ValidationInitiator")
  validationsAccepted      ConversationValidation[]  @relation("ValidationAcceptor")

  // Uploads
  uploads Upload[]

  // Social graph
  connectionsSent     ConnectionRequest[] @relation("ConnectionsSent")
  connectionsReceived ConnectionRequest[] @relation("ConnectionsReceived")

  // Events
  eventsCreated Event[]     @relation("EventsCreated")
  eventRsvps    EventRsvp[]

  // Mentoring
  mentorAvailabilities   MentorAvailability[]
  mentorBookingsAsMentor MentorBooking[]      @relation("MentorBookingsMentor")
  mentorBookingsAsMentee MentorBooking[]      @relation("MentorBookingsMentee")

  // Notifications
  notifications Notification[]

  // Moderation
  reportsFiled    Report[] @relation("ReportsFiled")
  reportsAgainst  Report[] @relation("ReportsAgainst")
  reportsResolved Report[] @relation("ReportsResolvedBy")

  // Billing
  subscriptions   Subscription[]
  seatAllocations SeatAllocation[]

  // Polls
  pollsCreated Poll[]     @relation("PollsCreated")
  pollVotes    PollVote[] @relation("PollVotes")

  // Jobs
  jobPostings JobPosting[] @relation("JobPostingsCreated")

  // Invites
  invitesSent     Invite[] @relation("InvitesSent")
  invitesReceived Invite[] @relation("InvitesReceived")

  // Groups
  groupsCreated      Group[]             @relation("GroupsCreated")
  groupMemberships   GroupMember[]
  groupPosts         GroupPost[]
  groupPostComments  GroupPostComment[]
  groupPostReactions GroupPostReaction[]

  // Phase 2: Analytics & Data
  profileViewsAsViewer ProfileView[]        @relation("ProfileViewsAsViewer")
  activities           UserActivity[]
  opportunities        Opportunity[]
  learningResources    LearningResource[]
  marketplaceServices  MarketplaceService[]
  cohortsOrganized     Cohort[]

  // Admin
  adminAuditLogs    AdminAuditLog[] @relation("AdminAuditLogs")
  cohortMemberships CohortMember[]

  // SSO / Multi-tenant
  userIdentities    UserIdentity[]
  tenantMemberships TenantMembership[]
  ssoAuthEvents     SSOAuthEvent[]

  // Milestones & Collaboration
  milestones       Milestone[] @relation("MilestonesOwned")
  milestoneCollabs Milestone[] @relation("MilestonesCollaborated")

  // Shortlist / Saved profiles
  savedProfiles SavedProfile[] @relation("SavedByUser")
  savedByUsers  SavedProfile[] @relation("UserSaved")

  // Investor pipeline — one row per startup an investor tracks, at whatever
  // stage. The watchlist, the pipeline board and the portfolio are three
  // filters over the same rows, not three tables.
  investorDeals   InvestorDeal[] @relation("DealsByInvestor")
  trackedByInvestors InvestorDeal[] @relation("DealsOnFounder")

  // Endorsements
  endorsementsGiven    Endorsement[] @relation("EndorsementsGiven")
  endorsementsReceived Endorsement[] @relation("EndorsementsReceived")

  // Research Workspace
  researchBoardsOwned         ResearchBoard[]             @relation("ResearchBoardsOwned")
  researchBoardCollaborations ResearchBoardCollaborator[] @relation("ResearchBoardCollaborations")
  researchComments            ResearchComment[]           @relation("ResearchComments")
  researchSnapshots           ResearchBoardSnapshot[]     @relation("ResearchSnapshots")
  canvasVersionsAuthored      CanvasVersion[]             @relation("CanvasVersionsAuthored")
  canvasBranchesCreated       CanvasBranch[]              @relation("CanvasBranchesCreated")
  canvasMergesAuthored        CanvasMerge[]               @relation("CanvasMergesAuthored")

  // Startup Builder
  builderWorkspacesOwned      BuilderWorkspace[]          @relation("BuilderWorkspacesOwned")
  builderCollaborations       BuilderCollaborator[]       @relation("BuilderCollaborations")
  builderCommentsAuthored     BuilderComment[]            @relation("BuilderCommentsAuthored")
  builderSectionComments      BuilderSectionComment[]     @relation("BuilderSectionCommentsAuthored")
  builderReviewsRequested     BuilderReview[]             @relation("BuilderReviewsRequested")
  builderReviewsAssigned      BuilderReview[]             @relation("BuilderReviewsAssigned")
  builderAIGenerations        BuilderAIGeneration[]       @relation("BuilderAIGenerations")
  builderExports              BuilderExport[]             @relation("BuilderExports")
  builderActivities           BuilderActivityLog[]        @relation("BuilderActivities")

  // Multi-Role / Persona System
  roleFacets                  UserRoleFacet[]

  // Organization System
  organizationMemberships     OrganizationMembership[]
  organizationsCreated        Organization[]              @relation("OrganizationsCreated")
  organizationMentorRoles     OrganizationMentor[]

  // Program System
  programParticipations       ProgramParticipant[]
  programsCreated             Program[]                   @relation("ProgramsCreated")

  // Stakeholder Profiles
  mentorProfile               MentorProfile?
  investorProfile             InvestorProfile?
  serviceProviderProfile      ServiceProviderProfile?

  // Mentorship Relationships
  mentorshipsAsMentor         MentorshipRelationship[]    @relation("MentorshipAsMentor")
  mentorshipsAsMentee         MentorshipRelationship[]    @relation("MentorshipAsMentee")
  mentorshipSessionsAsMentor  MentorshipSession[]         @relation("SessionAsMentor")
  mentorshipSessionsAsMentee  MentorshipSession[]         @relation("SessionAsMentee")
  mentorRequestsSent          MentorRequest[]             @relation("MentorRequestsSent")
  mentorRequestsReceived      MentorRequest[]             @relation("MentorRequestsReceived")

  // Preferences & Matching
  userPreference              UserPreference?
  matchProfile                MatchProfile?
  userAchievements            UserAchievement[]
  onboardingProgress          OnboardingProgress?
  matchSuggestionsAsSource    MatchSuggestion[]           @relation("MatchSuggestionsAsSource")
  matchSuggestionsAsTarget    MatchSuggestion[]           @relation("MatchSuggestionsAsTarget")

  // Fundraising
  fundraisingRounds           FundraisingRound[]          @relation("FundraisingRoundOwner")
  pipelineLeadsAdded          InvestorPipelineLead[]      @relation("PipelineLeadsAdded")
  dataRoomDocsUploaded        DataRoomDocument[]          @relation("DataRoomDocsUploaded")

  // Coaching
  coachingSessionsAsCoach     CoachingSession[]           @relation("CoachingSessions_Coach")
  coachingSessionsAsClient    CoachingSession[]           @relation("CoachingSessions_Client")

  // Expert Reviews
  expertReviewsRequested      ExpertReview[]              @relation("ExpertReviews_Requester")
  expertReviewsAssigned       ExpertReview[]              @relation("ExpertReviews_Expert")

  // Service Marketplace
  serviceOffers               ServiceOffer[]              @relation("ServiceOffers_Provider")
  serviceInquiriesAsClient    ServiceInquiry[]            @relation("ServiceInquiries_Client")
  serviceInquiriesAsProvider  ServiceInquiry[]            @relation("ServiceInquiries_Provider")

  // Startup Snapshot (investor view)
  startupSnapshots            StartupSnapshot[]           @relation("StartupSnapshots")

  // Product Requirements
  productRequirementDocs      ProductRequirementDoc[]     @relation("PRDAuthor")

  // Startup Applications
  startupApplications         StartupApplication[]        @relation("ApplicationsSubmitted")

  // Workspace Comments
  workspaceComments           WorkspaceComment[]          @relation("WorkspaceCommentAuthor")

  // Billing & Usage
  paymentRecords              PaymentRecord[]             @relation("UserPayments")
  usageRecords                UsageRecord[]               @relation("UserUsageRecords")

  // Safety — Block system
  blocksGiven                 UserBlock[]                 @relation("BlocksGiven")
  blocksReceived              UserBlock[]                 @relation("BlocksReceived")

  // Audit log
  auditLogs                   AuditLog[]                  @relation("AuditLogsActor")

  // Skill endorsements
  skillEndorsementsGiven      SkillEndorsement[]          @relation("SkillEndorsementsGiven")
  skillEndorsementsReceived   SkillEndorsement[]          @relation("SkillEndorsementsReceived")

  // Referrals
  referralsMade               Referral[]                  @relation("ReferralsMade")
  referralsReceived           Referral[]                  @relation("ReferralsReceived")

  // Follow
  followers                   UserFollow[]                @relation("Followers")
  founderUpdates              FounderUpdate[]             @relation("FounderUpdates")
  following                   UserFollow[]                @relation("Following")

  // Digest preference
  digestPreference            ActivityDigestPreference?   @relation("DigestPreference")

  // Portfolio
  portfolioItems              ProfilePortfolioItem[]      @relation("PortfolioItems")

  // AI Assistant
  aiAssistantSessions         AIAssistantSession[]        @relation("AIAssistantSessions")

  // AI Conversation System
  aiConversations             AIConversation[]            @relation("AIConversations")
  aiPreferences               AIUserPreference?           @relation("AIPreferences")
  aiPromptTemplates           AIPromptTemplate[]          @relation("AIPromptTemplates")

  // Reputation
  reputationScore             UserReputationScore?        @relation("ReputationScore")

  // Readiness history
  readinessReports            StartupReadinessReport[]    @relation("ReadinessReports")

  // Mentor Reviews
  mentorReviewsGiven          MentorReview[]              @relation("MentorReviewsGiven")
  mentorReviewsReceived       MentorReview[]              @relation("MentorReviewsReceived")

  // Investor Watchlist
  investorWatchlistItems      InvestorWatchlistItem[]     @relation("InvestorWatchlist")
  watchlistedByInvestors      InvestorWatchlistItem[]     @relation("WatchlistedByInvestors")

  // Data room access logs
  dataRoomAccesses            DataRoomAccessLog[]         @relation("DataRoomAccesses")

  // Notification channel preferences
  notificationChannels        UserNotificationChannel[]   @relation("NotificationChannels")

  // Calendar
  calendarEvents              CalendarEvent[]             @relation("CalendarEvents")

  // Public profile
  publicProfile               PublicProfile?              @relation("PublicProfile")

  // Feed system
  feedPosts                   FeedPost[]                  @relation("FeedPosts")
  feedComments                FeedComment[]               @relation("FeedComments")
  feedLikes                   FeedLike[]                  @relation("FeedLikes")
  feedBookmarks               FeedBookmark[]              @relation("FeedBookmarks")

  // Support tickets
  supportTickets              SupportTicket[]             @relation("SupportTickets")
  assignedTickets             SupportTicket[]             @relation("AssignedTickets")
  ticketMessages              TicketMessage[]             @relation("TicketMessages")

  // Saved searches
  savedSearches               SavedSearch[]               @relation("SavedSearches")
  savedItems                  SavedItem[]                 @relation("SavedItems")

  // Platform announcements
  platformAnnouncements       PlatformAnnouncement[]      @relation("PlatformAnnouncements")
  platformAnnouncementDismissals PlatformAnnouncementDismissal[] @relation("PlatformAnnouncementDismissals")

  // Phase 1 — Collaboration Architecture relations
  artifactBranches            ArtifactBranch[]            @relation("ArtifactBranchesCreated")
  changeProposals             ChangeProposal[]            @relation("ChangeProposalsCreated")
  artifactShareLinks          ArtifactShareLink[]         @relation("ArtifactShareLinksCreated")

  // Gamification Engine
  xpEvents                    XPEvent[]                   @relation("XPEvents")
  userGamificationBadges      UserGamificationBadge[]     @relation("UserGamificationBadges")
  streakRecord                StreakRecord?                @relation("StreakRecord")
  contributionScores          ContributionScore[]          @relation("ContributionScores")

  // Phase G4 — Admin Intelligence
  abuseFlags                  AbuseFlag[]                 @relation("UserAbuseFlags")
  experimentAssignments       ExperimentAssignment[]      @relation("UserExperimentAssignments")

  // Behavioral AI Optimizer
  behavioralState             UserBehavioralState?        @relation("UserBehavioralState")
  nudgeLogs                   NudgeLog[]                  @relation("UserNudgeLogs")

  // Commitments: need cards and the ladder from interest to agreed terms
  commitmentCards             CommitmentCard[]            @relation("CommitmentCardsOwned")
  commitmentThreads           CommitmentThread[]          @relation("CommitmentThreadsAsCandidate")
  commitmentMessages          CommitmentMessage[]         @relation("CommitmentMessagesAuthored")
  commitmentTerms             CommitmentTerms[]           @relation("CommitmentTermsProposed")

  @@index([role, moderationStatus])
  @@index([lastSeenAt])
  @@index([createdAt])
}

model Profile {
  id              String  @id @default(uuid())
  userId          String  @unique
  user            User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName     String
  headline        String?
  bio             String? @db.Text
  location        String?
  timezone        String?
  languages       Json? // string[] e.g. ["en", "el"]
  avatarUrl       String?
  rolePayload     Json? // role-specific: industry, stage, expertiseAreas, checkSize, etc.
  visibilityRules Json? // { email?: "public"|"connections"|"private", ... }

  // Organization-specific fields
  tagline  String?
  website  String?
  mission  String? @db.Text
  industry String?
  focus    String? // comma-separated focus areas
  size     String? // organization size

  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  skills    ProfileSkill[]

  // Phase 2: Analytics
  views ProfileView[]

  @@index([location])
  @@index([createdAt])
}

model Skill {
  id        String         @id @default(uuid())
  name      String
  slug      String         @unique
  category  String? // e.g. "technical", "business", "design"
  createdAt DateTime       @default(now())
  profiles  ProfileSkill[]
}

model ProfileSkill {
  profileId String
  profile   Profile  @relation(fields: [profileId], references: [id], onDelete: Cascade)
  skillId   String
  skill     Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level     String? // "beginner" | "intermediate" | "expert" (optional)
  createdAt DateTime @default(now())

  @@id([profileId, skillId])
}

model RefreshToken {
  id         String   @id @default(uuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  deviceInfo String?
}

model Conversation {
  id            String                    @id @default(uuid())
  type          ConversationType          @default(direct)
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  lastMessageAt DateTime?
  participants  ConversationParticipant[]
  messages      Message[]
  validation    ConversationValidation?
}

model ConversationValidation {
  id                  String                     @id @default(uuid())
  conversationId      String                     @unique
  conversation        Conversation               @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mode                ConversationValidationMode @default(casual)
  initiatedById       String?
  initiatedBy         User?                      @relation("ValidationInitiator", fields: [initiatedById], references: [id], onDelete: SetNull)
  initiatedAt         DateTime?
  acceptedById        String?
  acceptedBy          User?                      @relation("ValidationAcceptor", fields: [acceptedById], references: [id], onDelete: SetNull)
  acceptedAt          DateTime?
  lastValidatedAt     DateTime?
  validationHash      String?                    @db.Text
  transcriptAvailable Boolean                    @default(false)
  createdAt           DateTime                   @default(now())
  updatedAt           DateTime                   @updatedAt

  @@index([conversationId])
}

model ConversationParticipant {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime?
  isPinned       Boolean      @default(false)
  isArchived     Boolean      @default(false)
  isMuted        Boolean      @default(false)

  @@id([conversationId, userId])
  @@index([userId])
}

model Message {
  id             String              @id @default(uuid())
  conversationId String
  conversation   Conversation        @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  sender         User                @relation(fields: [senderId], references: [id], onDelete: Cascade)
  body           String              @db.Text
  createdAt      DateTime            @default(now())
  editedAt       DateTime?
  deletedAt      DateTime?
  readAt         DateTime?
  attachments    MessageAttachment[]

  @@index([conversationId, createdAt])
  @@index([senderId])
}

model MessageAttachment {
  id        String  @id @default(uuid())
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  uploadId  String?
  upload    Upload? @relation(fields: [uploadId], references: [id], onDelete: SetNull)
  url       String
  mimeType  String?
  fileName  String?
  sizeBytes Int?
}

model Upload {
  id           String     @id @default(uuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind         UploadKind
  key          String
  url          String
  mimeType     String?
  originalName String?
  sizeBytes    Int?
  createdAt    DateTime   @default(now())

  messageAttachments MessageAttachment[]
  researchNodes      ResearchNode[]

  @@index([userId])
  @@index([kind])
}

model ConnectionRequest {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  requester   User             @relation("ConnectionsSent", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver    User             @relation("ConnectionsReceived", fields: [receiverId], references: [id], onDelete: Cascade)
  message     String?          @db.Text
  status      ConnectionStatus @default(pending)
  respondedAt DateTime?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@unique([requesterId, receiverId])
  @@index([receiverId, status])
  @@index([requesterId, status])
}

model Event {
  id            String      @id @default(uuid())
  creatorId     String
  creator       User        @relation("EventsCreated", fields: [creatorId], references: [id], onDelete: Cascade)
  title         String
  description   String?     @db.Text
  type          EventType   @default(networking)
  startAt       DateTime
  endAt         DateTime?
  timezone      String?
  location      String?
  isOnline      Boolean     @default(false)
  meetingUrl    String?
  capacity      Int?
  coverImageUrl String?
  isFeatured    Boolean     @default(false)
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  rsvps         EventRsvp[]

  @@index([startAt])
  @@index([creatorId])
  @@index([isFeatured])
}

model EventRsvp {
  eventId     String
  userId      String
  event       Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user        User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  status      RsvpStatus @default(going)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
  checkedInAt DateTime?

  @@id([eventId, userId])
  @@index([userId])
}

model MentorAvailability {
  id        String   @id @default(uuid())
  mentorId  String
  mentor    User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  weekday   Int // 0-6
  startTime String // "09:00"
  endTime   String
  timezone  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([mentorId])
}

model MentorBooking {
  id                    String        @id @default(uuid())
  mentorId              String
  mentor                User          @relation("MentorBookingsMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  menteeId              String
  mentee                User          @relation("MentorBookingsMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  startAt               DateTime
  endAt                 DateTime
  timezone              String?
  meetingType           MeetingType   @default(video)
  meetingUrl            String?
  notes                 String?       @db.Text
  status                BookingStatus @default(requested)
  priceCents            Int?
  currency              String?       @default("USD")
  stripePaymentIntentId String?       @unique
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  @@index([mentorId, startAt])
  @@index([menteeId, startAt])
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  link      String?
  meta      Json?
  createdAt DateTime         @default(now())
  readAt    DateTime?

  @@index([userId, createdAt])
  @@index([userId, readAt])
}

/// One refusal by a safety rule (contact details, promised returns), for the
/// half-yearly transparency report. Deliberately no user and no text: the
/// kind, where it happened and when. Schema-only like the other new models
/// (`prisma db push`).
model TransparencyEvent {
  id        String   @id @default(uuid())
  kind      String
  surface   String
  createdAt DateTime @default(now())

  @@index([kind, createdAt])
}

model Report {
  id             String       @id @default(uuid())
  type           ReportType
  status         ReportStatus @default(pending)
  reporterId     String
  reporter       User         @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reportedId     String
  reported       User         @relation("ReportsAgainst", fields: [reportedId], references: [id], onDelete: Cascade)
  reason         String       @db.Text
  context        Json?
  resolvedAt     DateTime?
  resolvedById   String?
  resolvedBy     User?        @relation("ReportsResolvedBy", fields: [resolvedById], references: [id], onDelete: SetNull)
  resolutionNote String?      @db.Text
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([status, createdAt])
  @@index([reportedId, status])
}

model Poll {
