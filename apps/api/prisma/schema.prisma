  // Recommendations
  recommendations Json?            // AI-generated recommendations
  blockers      Json?              // Critical blockers identified
  
  // Timestamps
  assessedAt    DateTime           @default(now())
  assessedById  String?
  
  // Version tracking
  version       Int                @default(1)
  
  @@unique([workspaceId, dimension, version])
  @@index([workspaceId])
  @@index([dimension])
  @@index([assessedAt])
}

// ── Builder AI Generation ─────────────────────────────────────────────────────
// Track AI generation requests and results

model BuilderAIGeneration {
  id            String           @id @default(uuid())
  workspaceId   String
  workspace     BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  userId        String
  user          User             @relation("BuilderAIGenerations", fields: [userId], references: [id], onDelete: Cascade)
  
  // Request details
  documentType  BuilderDocumentType?
  sectionKey    String?
  prompt        String           @db.Text
  promptHash    String           // For caching/deduplication
  
  // AI configuration
  model         String           // "gpt-4", "claude-3-opus", etc.
  temperature   Float            @default(0.7)
  maxTokens     Int?
  
  // Response
  response      Json?            // Generated content
  tokensUsed    Int?
  latencyMs     Int?
  
  // Status
  status        String           @default("pending") // "pending", "completed", "failed", "cached"
  errorMessage  String?          @db.Text
  
  // Cost tracking
  costCents     Int?             // Cost in cents
  
  // Timestamps
  createdAt     DateTime         @default(now())
  completedAt   DateTime?
  
  @@index([workspaceId])
  @@index([userId])
  @@index([documentType])
  @@index([promptHash])
  @@index([status])
  @@index([createdAt])
