// ─────────────────────────────────────────────────────────────────────────────
// AI Assistant Session — Chat history with the platform AI assistant
// ─────────────────────────────────────────────────────────────────────────────

enum AIAssistantContext {
  general
  workspace_builder
  pitch_deck
  fundraising
  mentor_prep
  match_explanation
  program_application
  readiness_coach
}

model AIAssistantSession {
  id          String              @id @default(uuid())
  userId      String
  user        User                @relation("AIAssistantSessions", fields: [userId], references: [id], onDelete: Cascade)

  context     AIAssistantContext  @default(general)
  entityType  String?             // "workspace", "program", etc.
  entityId    String?             // Reference to a specific workspace/program

  title       String?             // Auto-generated summary title
  isArchived  Boolean             @default(false)

  messages    AIAssistantMessage[]

  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  @@index([userId])
  @@index([userId, context])
  @@index([userId, isArchived, updatedAt])
}

enum AIMessageRole {
  user
  assistant
  system
}

model AIAssistantMessage {
  id          String             @id @default(uuid())
  sessionId   String
  session     AIAssistantSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  role        AIMessageRole
  content     String             @db.Text
  tokensUsed  Int?

  // Action metadata (when AI suggested actions)
  actionType  String?            // "generate_section", "suggest_match", etc.
  actionMeta  Json?

  createdAt   DateTime           @default(now())

  @@index([sessionId])
  @@index([sessionId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// User Reputation Score — Computed contribution & trust score per user
// ─────────────────────────────────────────────────────────────────────────────

model UserReputationScore {
  id                  String   @id @default(uuid())
  userId              String   @unique
  user                User     @relation("ReputationScore", fields: [userId], references: [id], onDelete: Cascade)

  // Overall score (0–100)
  overallScore        Int      @default(0)

  // Dimension scores (0–100 each)
  profileCompleteness Int      @default(0)
  networkActivity     Int      @default(0)
  communityContrib    Int      @default(0)
  mentorActivity      Int      @default(0)
  workspaceActivity   Int      @default(0)
  endorsementsScore   Int      @default(0)

  // Trust signals
  isVerified          Boolean  @default(false)
  verifiedAt          DateTime?
  verificationMethod  String?  // "manual", "linkedin", "email_domain"
  trustTier           Int      @default(1) // 1-5 trust tiers

  // Badges earned
  badges              String[] @default([])

  // Leaderboard
  globalRank          Int?
  weeklyDelta         Int      @default(0) // score change this week

  calculatedAt        DateTime @default(now())
  updatedAt           DateTime @updatedAt

  @@index([overallScore])
  @@index([globalRank])
  @@index([isVerified])
  @@index([trustTier])
}

// ─────────────────────────────────────────────────────────────────────────────
// Startup Readiness Report — Time-series snapshot of readiness assessment
// Enables history charts and progress tracking on /readiness page
// ─────────────────────────────────────────────────────────────────────────────

model StartupReadinessReport {
  id            String   @id @default(uuid())
  userId        String
  user          User     @relation("ReadinessReports", fields: [userId], references: [id], onDelete: Cascade)
  workspaceId   String?

  // Overall snapshot score (0–100)
  overallScore  Int

  // Per-dimension scores (0–100 each, mirrors ReadinessDimension enum)
  teamScore      Int      @default(0)
  marketScore    Int      @default(0)
  productScore   Int      @default(0)
  businessScore  Int      @default(0)
  fundingScore   Int      @default(0)
  executionScore Int      @default(0)

  // Context
  assessmentType String   @default("auto") // "auto", "manual", "ai_assisted"
  notes          String?  @db.Text

  // Benchmark comparison data
  industryBenchmark Int?  // Average score for same industry/stage cohort
  stagePercentile   Int?  // Percentile vs startups at same stage (0–100)

  // Triggered by (e.g., after completing a criterion or workspace edit)
  triggeredBy   String?  // "criterion_update", "workspace_save", "manual", "scheduled"

  snapshotAt    DateTime @default(now())

  @@index([userId])
  @@index([userId, snapshotAt])
  @@index([workspaceId])
  @@index([snapshotAt])
  @@index([overallScore])
}

// ─────────────────────────────────────────────────────────────────────────────
// Data Room Access Log — Investor access tracking per document
// Enables transparency in fundraising data room activity
// ─────────────────────────────────────────────────────────────────────────────

model DataRoomAccessLog {
  id           String           @id @default(uuid())
  documentId   String
  document     DataRoomDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  accessorId   String
  accessor     User             @relation("DataRoomAccesses", fields: [accessorId], references: [id], onDelete: Cascade)

  // Access metadata
  ipAddress    String?
  userAgent    String?
  durationSecs Int?             // Time spent viewing (seconds)

  // Context
  roundId      String?          // Which fundraising round context
  source       String?          // "email_link", "direct", "investor_pipeline", "data_room_share"

  // NDA / terms accepted at time of access
  ndaAccepted  Boolean          @default(false)

  accessedAt   DateTime         @default(now())

  @@index([documentId])
  @@index([accessorId])
  @@index([documentId, accessedAt])
  @@index([accessorId, accessedAt])
  @@index([roundId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Mentorship Goal — Structured, trackable goals within a mentorship relationship
// Replaces the untyped Json goals field with a proper relational model
// ─────────────────────────────────────────────────────────────────────────────

enum MentorshipGoalStatus {
  active
  in_progress
  completed
  paused
  cancelled
}

model MentorshipGoal {
  id             String                 @id @default(uuid())
  relationshipId String
  relationship   MentorshipRelationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  createdById    String                 // mentor or mentee who set the goal

  title          String
  description    String?                @db.Text
  category       String?                // "fundraising", "product", "team", "personal_growth", "skills", "network"
  targetDate     DateTime?

  status         MentorshipGoalStatus   @default(active)
  progressPct    Int                    @default(0) // 0–100

  // Success criteria (OKR-style)
  successCriteria String?               @db.Text
  keyResults      String[]              @default([])

  // Session tracking
  lastDiscussedAt DateTime?
  checkInNotes    String?               @db.Text

  // Completion
  completedAt     DateTime?
  completionNote  String?               @db.Text

  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt

  @@index([relationshipId])
  @@index([relationshipId, status])
  @@index([targetDate])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────────────────────
// User Notification Channel — Granular per-user, per-channel, per-category
// Extends UserPreference with fine-grained control per notification category
// ─────────────────────────────────────────────────────────────────────────────

enum NotificationDeliveryChannel {
  in_app
  email
  push
  sms
}

model UserNotificationChannel {
  id         String                      @id @default(uuid())
  userId     String
  user       User                        @relation("NotificationChannels", fields: [userId], references: [id], onDelete: Cascade)

  // Channel + category combination
  channel    NotificationDeliveryChannel
  category   String                      // "matches", "messages", "connections", "program", "milestone", "community", "system", "fundraising"

  isEnabled  Boolean                     @default(true)

  // Digest control
  frequency  String                      @default("instant") // "instant", "daily", "weekly", "never"

  // Quiet hours (stored as "HH:MM" 24h strings, null = no quiet hours)
  quietFrom  String?
  quietUntil String?

  updatedAt  DateTime                    @updatedAt

  @@unique([userId, channel, category])
  @@index([userId])
  @@index([userId, channel])
  @@index([userId, isEnabled])
}

// ─────────────────────────────────────────────────────────────────────────────
// Calendar Event — Unified schedule: sessions, milestones, events, deadlines
// ─────────────────────────────────────────────────────────────────────────────

enum CalendarEventType {
  milestone
  session
  event
  deadline
  meeting
  reminder
}

model CalendarEvent {
  id            String            @id @default(uuid())
  userId        String
  user          User              @relation("CalendarEvents", fields: [userId], references: [id], onDelete: Cascade)

  title         String
  description   String?           @db.Text
  eventType     CalendarEventType
  allDay        Boolean           @default(false)

  startAt       DateTime
  endAt         DateTime?

  location      String?
  isVirtual     Boolean           @default(false)
  meetingUrl    String?

  // Priority & status
  priority      String?           // "high", "medium", "low"
  status        String            @default("scheduled") // "scheduled", "completed", "cancelled"

  // Linked entities
  workspaceId   String?
  milestoneId   String?
  programId     String?
  tenantId      String?

  // Recurrence (simple pattern, null = one-off)
  recurrence    String?           // "daily", "weekly", "biweekly", "monthly"
  recurrenceEnd DateTime?

  // Participants (user IDs)
  participantIds String[]         @default([])

  // Reminders
  reminderMinutes Int?            // minutes before event to send reminder

  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([userId])
  @@index([userId, startAt])
  @@index([userId, eventType])
  @@index([startAt])
  @@index([tenantId, startAt])
  @@index([workspaceId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Public Profile — Shareable external profile link with controlled visibility
// ─────────────────────────────────────────────────────────────────────────────

model PublicProfile {
  id            String   @id @default(uuid())
  userId        String   @unique
  user          User     @relation("PublicProfile", fields: [userId], references: [id], onDelete: Cascade)

  slug          String   @unique // e.g. "john-doe-founder"
  isPublished   Boolean  @default(false)

  // Visibility controls
  showEmail     Boolean  @default(false)
  showLocation  Boolean  @default(true)
  showSkills    Boolean  @default(true)
  showBio       Boolean  @default(true)
  showPortfolio Boolean  @default(true)
  showStats     Boolean  @default(false)

  // Custom sections
  customHeadline String?
  customBio      String? @db.Text
  socialLinks    Json?   // { linkedin, twitter, github, website }

  // Analytics
  viewCount     Int      @default(0)
  lastViewedAt  DateTime?

  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([slug])
  @@index([isPublished])
}

// ─────────────────────────────────────────────────────────────────────────────
// Feed Post — Community and platform-wide feed content
// ─────────────────────────────────────────────────────────────────────────────

enum FeedPostType {
  text
  announcement
  milestone_share
  workspace_update
  question
  poll
  event_share
  resource_share
}

enum FeedPostVisibility {
  public
  connections_only
  community_only
  tenant_only
  private
}

model FeedPost {
  id            String             @id @default(uuid())
  authorId      String
  author        User               @relation("FeedPosts", fields: [authorId], references: [id], onDelete: Cascade)

  postType      FeedPostType       @default(text)
  visibility    FeedPostVisibility @default(public)

  title         String?
  content       String             @db.Text
  richContent   Json?              // structured content blocks

  // Optional attachments
  mediaUrls     String[]           @default([])
  linkPreview   Json?              // { url, title, description, image }

  // Linked entities
  communityId   String?
  workspaceId   String?
  milestoneId   String?
  tenantId      String?

  // Engagement metrics
  likeCount     Int                @default(0)
  commentCount  Int                @default(0)
  shareCount    Int                @default(0)
  viewCount     Int                @default(0)

  // Moderation
  isHidden      Boolean            @default(false)
  isPinned      Boolean            @default(false)
  moderationNote String?

  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  // Relations
  comments      FeedComment[]
  likes         FeedLike[]
  bookmarks     FeedBookmark[]

  @@index([authorId])
  @@index([communityId, createdAt])
  @@index([tenantId, createdAt])
  @@index([visibility, createdAt])
  @@index([postType, createdAt])
  @@index([isPinned, createdAt])
}

/// A reader's feed settings (`/feed` preferences panel). One row per user;
/// absent means the defaults in `feed.service.ts`.
model FeedPreference {
  userId    String   @id
  prefs     Json
  updatedAt DateTime @updatedAt
}

/// Posts a reader chose to hide from their own feed ("Hide" in the post menu).
model FeedHiddenPost {
  id        String   @id @default(uuid())
  userId    String
  postId    String
  createdAt DateTime @default(now())

  @@unique([userId, postId])
  @@index([userId])
}

/// A pitch deck its owner chose to publish at /pitch/[id]. The id is the
/// public one; the deck itself stays the builder's `pitch_deck` document.
/// Unpublishing keeps the row (and its counts) with `isPublic` false.
model PublicPitch {
  id              String   @id @default(uuid())
  documentId      String   @unique
  ownerId         String
  isPublic        Boolean  @default(true)
  allowContact    Boolean  @default(true)
  views           Int      @default(0)
  shares          Int      @default(0)
  contactRequests Int      @default(0)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contacts        PitchContactRequest[]

  @@index([ownerId])
}

/// "Contact" on a public pitch: whoever writes leaves the address they want
/// answered at; the owner is notified and replies from their own mail.
model PitchContactRequest {
  id        String      @id @default(uuid())
  pitchId   String
  pitch     PublicPitch @relation(fields: [pitchId], references: [id], onDelete: Cascade)
  name      String
  email     String
  message   String?     @db.Text
  createdAt DateTime    @default(now())

  @@index([pitchId, createdAt])
}

enum VerificationMethod {
  work_email
  linkedin_identity
  linkedin_workplace
  admin
}

/// One way a person has proved who they are (`packages/shared/src/verification`).
/// Removing a signal deletes its row; a work email lapses after a year.
model UserVerification {
  id         String             @id @default(uuid())
  userId     String
  method     VerificationMethod
  detail     String?            // the work domain for work_email
  verifiedAt DateTime           @default(now())
  expiresAt  DateTime?

  @@unique([userId, method])
  @@index([userId])
}

/// A pending work-email code. One per person; the code is stored hashed.
model WorkEmailChallenge {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String
  codeHash  String
  attempts  Int      @default(0)
  expiresAt DateTime
  createdAt DateTime @default(now())
}

/// LinkedIn data fetched through the DMA portability API, waiting for its
/// owner to open the profile form. Only allowlisted columns; read once; 15 minutes.
model ProfileImportDraft {
  userId    String   @id
  records   Json
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum FounderUpdateVisibility {
  followers
  public
}

/// A founder's periodic update to the people who follow them: what moved,
/// a few figures, what they need. Public ones get an unguessable token for
/// /u/[token], the page a founder shares on LinkedIn.
model FounderUpdate {
  id          String                  @id @default(uuid())
  authorId    String
  author      User                    @relation("FounderUpdates", fields: [authorId], references: [id], onDelete: Cascade)
  title       String
  body        String                  @db.Text
  metrics     Json                    // [{ label, value }]
  asks        String[]                @default([])
  visibility  FounderUpdateVisibility @default(followers)
  publicToken String?                 @unique
  milestoneId String?
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt

  @@index([authorId, createdAt])
}

model FeedComment {
  id          String   @id @default(uuid())
  postId      String
  post        FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  authorId    String
  author      User     @relation("FeedComments", fields: [authorId], references: [id], onDelete: Cascade)

  content     String   @db.Text
  parentId    String?  // for nested replies

  likeCount   Int      @default(0)
  isHidden    Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([postId, createdAt])
  @@index([authorId])
  @@index([parentId])
}

model FeedLike {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("FeedLikes", fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId])
}

model FeedBookmark {
  id        String   @id @default(uuid())
  postId    String
  post      FeedPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  userId    String
  user      User     @relation("FeedBookmarks", fields: [userId], references: [id], onDelete: Cascade)

  notes     String?
  createdAt DateTime @default(now())

  @@unique([postId, userId])
  @@index([userId, createdAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Support Ticket — Help desk and user support system
// ─────────────────────────────────────────────────────────────────────────────

enum TicketStatus {
  open
  in_progress
  waiting_on_user
  waiting_on_support
  resolved
  closed
}

enum TicketPriority {
  low
  medium
  high
  urgent
}

enum TicketCategory {
  account
  billing
  technical
  feature_request
  bug_report
  matching
  messaging
  workspace
  community
  program
  other
}

model SupportTicket {
  id            String          @id @default(uuid())
  userId        String
  user          User            @relation("SupportTickets", fields: [userId], references: [id], onDelete: Cascade)

  ticketNumber  String          @unique // e.g. "CFB-2024-00001"
  subject       String
  description   String          @db.Text

  category      TicketCategory
  priority      TicketPriority  @default(medium)
  status        TicketStatus    @default(open)

  // Assignment
  assignedToId  String?
  assignedTo    User?           @relation("AssignedTickets", fields: [assignedToId], references: [id], onDelete: SetNull)

