enum ReferralStatus {
  pending    // invitee received link but not registered
  registered // invitee signed up
  converted  // invitee completed onboarding / upgraded
}

model Referral {
  id            String         @id @default(uuid())
  referrerId    String
  referrer      User           @relation("ReferralsMade", fields: [referrerId], references: [id], onDelete: Cascade)
  refereeId     String?
  referee       User?          @relation("ReferralsReceived", fields: [refereeId], references: [id], onDelete: SetNull)

