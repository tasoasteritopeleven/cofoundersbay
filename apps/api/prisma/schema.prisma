  fromUser    User     @relation("SkillEndorsementsGiven", fields: [fromUserId], references: [id], onDelete: Cascade)
  toUserId    String
  toUser      User     @relation("SkillEndorsementsReceived", fields: [toUserId], references: [id], onDelete: Cascade)
