// ─────────────────────────────────────────────────────────────────────────────
// Phase 1 — Collaboration Architecture: Branching, Proposals, Sharing, CRDT
// Architecture report: COLLABORATION_ARCHITECTURE.md §2B
// ─────────────────────────────────────────────────────────────────────────────

enum ArtifactBranchStatus {
  open
  review
  merged
  closed
  abandoned
}

enum ChangeProposalStatus {
  open
  approved
  changes_requested
  merged
  closed
}

enum ShareLinkPermission {
  view
  comment
  suggest
}

enum VersionTrigger {
  explicit         // Manual save / "Create checkpoint" button
  autosave         // Auto-save threshold (≥500 char diff OR 5-min idle)
  pre_merge        // Snapshot before branch merge
  merge            // Created by merging a branch
  review_snapshot  // Snapshot when review is requested
  published        // Export / publish event
  restore          // Created by restoring a previous version
}

// ── Artifact Branch ─────────────────────────────────────────────────────────
// Draft variants / parallel versions for review (GitHub-style branching)
// Architecture report §2B, §4D

model ArtifactBranch {
  id              String              @id @default(uuid())
  documentId      String
  document        BuilderDocument     @relation("DocumentBranches", fields: [documentId], references: [id], onDelete: Cascade)

  name            String              // "mentor-review-draft", "v2-rewrite", "pitch-overhaul"
  description     String?             @db.Text
  createdById     String
  createdBy       User                @relation("ArtifactBranchesCreated", fields: [createdById], references: [id], onDelete: Cascade)

  // Branch state
  baseVersionId   String              // BuilderDocumentVersion.id this branched from
  baseVersionNum  Int                 // Denormalized: version number at branch point
  content         Json                // Current branch content (working copy)

  status          ArtifactBranchStatus @default(open)

  // Merge metadata
  mergedAt        DateTime?
  mergedById      String?
  mergeVersionId  String?             // The BuilderDocumentVersion.id created by merge

  // Timestamps
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  // Relations
  proposals       ChangeProposal[]

  @@index([documentId])
  @@index([createdById])
  @@index([status])
  @@index([documentId, status])
}

// ── Change Proposal ─────────────────────────────────────────────────────────
// Structured review request tied to a branch (GitHub PR equivalent)
// Architecture report §2B, §4C

model ChangeProposal {
  id              String              @id @default(uuid())
  branchId        String
  branch          ArtifactBranch      @relation(fields: [branchId], references: [id], onDelete: Cascade)
  documentId      String              // Denormalized from branch for direct querying

  title           String
  description     String?             @db.Text
  createdById     String
  createdBy       User                @relation("ChangeProposalsCreated", fields: [createdById], references: [id], onDelete: Cascade)

  // Review state
  status          ChangeProposalStatus @default(open)

  // Diff metadata (computed on creation / update)
  diffSummary     Json?               // { sectionsChanged: [...], fieldsAdded: [...], fieldsRemoved: [...] }
  changedSections String[]            @default([])

  // Reviewer assignments (User IDs)
  reviewerIds     String[]            @default([])

  // Timestamps
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  mergedAt        DateTime?

  @@index([branchId])
  @@index([documentId])
  @@index([createdById])
  @@index([status])
  @@index([documentId, status])
}

// ── Artifact Share Link ─────────────────────────────────────────────────────
// Time-limited external access tokens for stakeholders without platform accounts
// Architecture report §2B, §3D

model ArtifactShareLink {
  id              String              @id @default(uuid())
  documentId      String?
  document        BuilderDocument?    @relation("DocumentShareLinks", fields: [documentId], references: [id], onDelete: Cascade)
  workspaceId     String?
  workspace       BuilderWorkspace?   @relation("WorkspaceShareLinks", fields: [workspaceId], references: [id], onDelete: Cascade)
  versionId       String?             // Optional: pin to specific version

  // Access config
  token           String              @unique // URL-safe random token
  permissions     ShareLinkPermission @default(view)
  password        String?             // Optional password protection (hashed)
  expiresAt       DateTime?
  maxViews        Int?
  viewCount       Int                 @default(0)

  // Metadata
  label           String?             // Human-readable label: "For Mentor X", "Investor review"
  recipientEmail  String?             // Optional: who this was shared with

  // Creator
  createdById     String
  createdBy       User                @relation("ArtifactShareLinksCreated", fields: [createdById], references: [id], onDelete: Cascade)
  isActive        Boolean             @default(true)

  // Timestamps
  createdAt       DateTime            @default(now())
  lastAccessedAt  DateTime?

  @@index([token])
  @@index([documentId])
  @@index([workspaceId])
  @@index([createdById])
  @@index([isActive])
  @@index([isActive, expiresAt])
}

// ── CRDT Sync State ─────────────────────────────────────────────────────────
// Server-side persistence for Yjs documents (Phase 3 will activate)
// Created now so the schema is ready; not populated until CRDT integration
// Architecture report §2B, §6C

model CRDTSyncState {
  id              String    @id @default(uuid())
  documentId      String
  document        BuilderDocument @relation("DocumentCRDTState", fields: [documentId], references: [id], onDelete: Cascade)
  sectionKey      String?         // null = whole document, non-null = specific section

  // Yjs document state (binary-encoded)
  yjsState        Bytes           // Y.Doc encoded state vector
  yjsUpdate       Bytes?          // Latest merged update delta

  // Checkpoint metadata
  lastClientId    String?
  operationCount  Int       @default(0)
  lastSyncAt      DateTime  @default(now())

  // Snapshot for cold-start (clients that can't replay ops)
  snapshotContent Json?
  snapshotAt      DateTime?

  // Timestamps
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@unique([documentId, sectionKey])
  @@index([documentId])
  @@index([lastSyncAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// GAMIFICATION ENGINE — XP · BADGES · STREAKS · CONTRIBUTION · MOMENTUM
// ═════════════════════════════════════════════════════════════════════════════

// ── XP Event Type Enum ────────────────────────────────────────────────────────
// Curated, anti-farm event taxonomy. Each type maps to base XP + cooldown
// enforced in GamificationService. No click-spam events are defined.

enum XPEventType {
  // Artifact lifecycle (builder documents)
  CREATE_ARTIFACT            // New BuilderDocument created
  COMPLETE_ARTIFACT          // completionPercent reaches 100
  IMPROVE_ARTIFACT           // completionPercent increases >= 10 percentage points

  // Research canvas
  CREATE_BOARD               // New ResearchBoard created
  SYNTHESIZE_BOARD           // Canvas exported / linked to Builder (cross-tool)
  LINK_ARTIFACTS             // ResearchNode linked to a BuilderDocument

  // Collaboration (validated — person must accept)
  INVITE_COLLABORATOR        // Collaborator added to workspace who accepts
  TEAM_CONTRIBUTION          // Meaningful edit/addition to shared workspace
  HIGH_QUALITY_CONTRIBUTION  // Your contribution referenced/used by a teammate

  // Mentoring & expert review
  RECEIVE_MENTOR_FEEDBACK    // ExpertReview or MentorBooking completed with feedback
  APPLY_FEEDBACK             // Artifact improved after receiving a review (APPLY chain)
  COMPLETE_REVIEW            // User completes an expert review for another
  PROVIDE_FEEDBACK           // Structured feedback given in review flow

  // Milestones
  COMPLETE_MILESTONE         // Milestone.status transitions to completed

  // External validation
  VALIDATED_PROGRESS         // External signal: match accepted, program applied, etc.

  // Streak milestone rewards (auto-awarded on crossing 7/14/30/60/90-day milestones)
  STREAK_BONUS               // Internal: awarded by updateStreak on milestone crossing
}

// ── Gamification Badge Enums ──────────────────────────────────────────────────

enum GamificationBadgeCategory {
  progress       // Completion of key deliverables
  consistency    // Meaningful-streak engagement
  collaboration  // Co-building and team contribution
  quality        // Validated, externally reviewed work
  learning       // Mentor engagement and iteration
  execution      // Real-world milestone completion
}

enum GamificationBadgeRarity {
  common
  uncommon
  rare
  epic
  legendary
}

// ── Streak Type ───────────────────────────────────────────────────────────────

enum StreakType {
  meaningful_daily  // Qualifying: CREATE_ARTIFACT, IMPROVE_ARTIFACT, SYNTHESIZE_BOARD, COMPLETE_MILESTONE
}

// ── XP Event ──────────────────────────────────────────────────────────────────
// Append-only event ledger. Source of truth for all XP totals and badge
// evaluation. Never deleted or mutated after insertion.

model XPEvent {
  id               String      @id @default(uuid())
  userId           String
  user             User        @relation("XPEvents", fields: [userId], references: [id], onDelete: Cascade)

  // Workspace context (null = personal action outside a workspace)
  workspaceId      String?

  eventType        XPEventType

  // Target entity that triggered the event
  entityType       String?     // "builder_document", "research_board", "milestone", "review", "connection"
  entityId         String?

  // XP accounting (stored at insertion time — immutable thereafter)
  xpAmount         Int         // Final XP credited (after multipliers + diminishing returns)
  baseXp           Int         // Raw base value before any modification
  weightMultiplier Float       @default(1.0)  // Complexity / collaboration multiplier

  // Anti-farming controls
  cooldownKey      String?     // Compound key enforcing per-event-per-entity cooldown
  isDiminished     Boolean     @default(false)  // Diminishing returns flag

  metadata         Json?       // { completionDelta, reviewRating, collaboratorCount, etc. }
  createdAt        DateTime    @default(now())

  @@index([userId])
  @@index([userId, eventType])
  @@index([userId, createdAt])
  @@index([workspaceId])
  @@index([eventType, createdAt])
  @@index([cooldownKey])
}

// ── Gamification Badge Definition ─────────────────────────────────────────────
// Rule-based badge catalogue. Criteria are JSON rule trees evaluated by the
// GamificationService badge engine on every relevant XP event.

model GamificationBadge {
  id          String                    @id @default(uuid())
  key         String                    @unique  // stable identifier, e.g. "first_artifact"
  name        String
  description String                    @db.Text

  category    GamificationBadgeCategory
  rarity      GamificationBadgeRarity   @default(common)

  // JSON rule tree — evaluated by evaluateBadgeCriteria()
  // Leaf types:
  //   { "type": "xp_event_count", "eventType": "COMPLETE_ARTIFACT", "minCount": 3 }
  //   { "type": "total_xp", "minXP": 500 }
  //   { "type": "streak_days", "minDays": 5 }
  //   { "type": "badge_earned", "badgeKey": "first_artifact" }
  // Composite:
  //   { "type": "and", "rules": [...] }
  //   { "type": "or",  "rules": [...] }
  criteria    Json

  iconName    String?   // Lucide icon name or asset key
  xpReward    Int       @default(0)    // Bonus XP credited on badge award
  isActive    Boolean   @default(true)
  sortOrder   Int       @default(100)
  createdAt   DateTime  @default(now())

  userBadges  UserGamificationBadge[]

  @@index([category])
  @@index([rarity])
  @@index([isActive])
}

// ── User Gamification Badge ────────────────────────────────────────────────────

model UserGamificationBadge {
  id        String            @id @default(uuid())
  userId    String
  user      User              @relation("UserGamificationBadges", fields: [userId], references: [id], onDelete: Cascade)
  badgeId   String
  badge     GamificationBadge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  awardedAt DateTime          @default(now())
  seenAt    DateTime?          // Set when user views the badge notification
  metadata  Json?             // Snapshot of criteria state at award time

  @@unique([userId, badgeId])
  @@index([userId])
  @@index([badgeId])
  @@index([awardedAt])
}

// ── Streak Record ──────────────────────────────────────────────────────────────
// One row per user. Tracks rolling meaningful-action streak with a grace window.

model StreakRecord {
  id              String     @id @default(uuid())
  userId          String     @unique
  user            User       @relation("StreakRecord", fields: [userId], references: [id], onDelete: Cascade)
  streakType      StreakType @default(meaningful_daily)

  currentStreak   Int        @default(0)   // Active consecutive qualifying days
  longestStreak   Int        @default(0)   // Historical maximum

  lastActiveDate  DateTime?  // UTC midnight of last qualifying day
  graceUsedAt     DateTime?  // Date grace period was consumed (max 1 per streak run)

  updatedAt       DateTime   @updatedAt

  @@index([currentStreak])
}

// ── Contribution Score ─────────────────────────────────────────────────────────
// Per-user, per-workspace contribution score (0–100, normalised within workspace).

model ContributionScore {
  id          String           @id @default(uuid())
  userId      String
  user        User             @relation("ContributionScores", fields: [userId], references: [id], onDelete: Cascade)
  workspaceId String
  workspace   BuilderWorkspace @relation("WorkspaceContributionScores", fields: [workspaceId], references: [id], onDelete: Cascade)

  score       Int              @default(0)

  // Raw counts before normalisation (stored for auditability)
  breakdown   Json?
  // {
  //   artifactsCreated: number,
  //   artifactsImproved: number,
  //   feedbackGiven: number,
  //   feedbackApplied: number,
  //   collaborationActions: number,
  //   usageByTeam: number
  // }

  updatedAt   DateTime         @updatedAt

  @@unique([userId, workspaceId])
  @@index([userId])
  @@index([workspaceId])
  @@index([score])
}

// ── Team Momentum Score ────────────────────────────────────────────────────────
// Workspace-level velocity and collaboration health (one row per workspace).

model TeamMomentumScore {
  id                   String           @id @default(uuid())
  workspaceId          String           @unique
  workspace            BuilderWorkspace @relation("WorkspaceTeamMomentum", fields: [workspaceId], references: [id], onDelete: Cascade)

  score                Int              @default(0)   // 0–100 composite
  velocity             Float            @default(0)   // Meaningful actions / day over 14-day window
  recentActivityScore  Int              @default(0)   // 0–100 recency-weighted
  collaborationDensity Float            @default(0)   // Multi-user actions / total actions

  breakdown            Json?
  // {
  //   activeContributors: number,
  //   recentMeaningfulActions: number,
  //   artifactProgressEvents: number,
  //   feedbackLoopsCompleted: number,
  //   milestoneCompletionRate: number
  // }

  updatedAt            DateTime         @updatedAt

  @@index([score])
}

// ── Mentor Feedback Metric ─────────────────────────────────────────────────────
// Tracks quality of the mentor/expert-review feedback loop per workspace.

model MentorFeedbackMetric {
  id                   String           @id @default(uuid())
  workspaceId          String           @unique
  workspace            BuilderWorkspace @relation("WorkspaceMentorMetrics", fields: [workspaceId], references: [id], onDelete: Cascade)

  feedbackCount        Int              @default(0)  // Total RECEIVE_MENTOR_FEEDBACK events
  appliedFeedbackCount Int              @default(0)  // APPLY_FEEDBACK events correlated to reviews
  appliedFeedbackRate  Float            @default(0)  // appliedFeedbackCount / max(feedbackCount, 1)

  avgResponseTimeHrs   Float            @default(0)  // Avg hrs between RECEIVE_MENTOR_FEEDBACK → APPLY_FEEDBACK
  improvementScore     Int              @default(0)  // 0–100; readiness delta after feedback rounds

  lastFeedbackAt       DateTime?
  updatedAt            DateTime         @updatedAt

  @@index([workspaceId])
}

// ── Gamification Readiness Score ───────────────────────────────────────────────
// Single-row cache of the 8-dimension gamification readiness model per workspace.
// Updated by GamificationService after any workspace-affecting XP event.
// Distinct from BuilderReadinessScore (per-dimension rows) — this model stores
// the full 8-dimension breakdown + composite in one queryable row.

model GamificationReadinessScore {
  id          String           @id @default(uuid())
  workspaceId String           @unique
  workspace   BuilderWorkspace @relation("WorkspaceGamificationReadiness", fields: [workspaceId], references: [id], onDelete: Cascade)

  // 0–100 overall composite (weighted across 8 dimensions)
  score                Int     @default(0)

  // Dimension scores (0–100 each)
  problemClarity       Int     @default(0)  // Problem nodes on canvas / problem section fill
  solutionClarity      Int     @default(0)  // Solution artifact section completeness
  marketUnderstanding  Int     @default(0)  // Market analysis documents completeness
  productDefinition    Int     @default(0)  // PRD / MVP spec completeness
  teamCompleteness     Int     @default(0)  // Co-founders + mentors + workspace collaborators
  executionReadiness   Int     @default(0)  // Milestones defined × completion rate
  validationScore      Int     @default(0)  // Expert reviews + feedback applied rate
  artifactCompleteness Int     @default(0)  // Avg completionPercent across all workspace docs

  dimensionBreakdown   Json?   // Evidence map: { dimension → { evidence, score, maxScore } }
  updatedAt            DateTime @updatedAt

  @@index([score])
}

// ══════════════════════════════════════════════════════════════════════════════
// PHASE G4 — ADMIN INTELLIGENCE LAYER
// ══════════════════════════════════════════════════════════════════════════════

// ── Abuse Flags ───────────────────────────────────────────────────────────────
// Records detected anti-gaming / anti-abuse signals per user.
// Created by AbuseDetectionService; reviewed and actioned by admins.

model AbuseFlag {
  id          String          @id @default(uuid())
  userId      String
  user        User            @relation("UserAbuseFlags", fields: [userId], references: [id], onDelete: Cascade)

  type        AbuseFlagType
  severity    Float           // 0.0–1.0 risk score
  description String?
  metadata    Json?           // { pattern, count, window, sampleEventIds, evidence }

  status      AbuseFlagStatus @default(pending)
  resolvedAt  DateTime?
  resolvedById String?
  actionTaken String?         // 'reduced_xp' | 'streak_freeze' | 'warning' | 'safe' | 'banned'

  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@index([userId])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
}

enum AbuseFlagType {
  burst_spam               // >10 events in 5 min
  low_quality_repetition   // repeated empty-entity events
  fake_collaboration       // mutual self-endorsement ring
  streak_manipulation      // minimum-viable actions to preserve streak
  empty_node_spam          // high-volume low-content canvas nodes
  self_link_abuse          // excessive self-referential artifact linking
  mutual_endorsement_ring  // graph-detected mutual endorsement cluster
}

enum AbuseFlagStatus {
  pending
  reviewed
  actioned
  dismissed
}

// ── System Config ─────────────────────────────────────────────────────────────
// Key-value store for live-tunable parameters (XP weights, thresholds, etc.)
// Avoids redeploy for formula constant changes. Consumed by services at runtime.

model SystemConfig {
  id          String    @id @default(uuid())
  key         String    @unique           // e.g. 'xp.create_artifact.base'
  value       Json                        // typed JSON value (number, object, array)
  description String?
  category    String?                     // 'xp_weights' | 'streak_config' | 'abuse_thresholds' | 'readiness_weights'
  updatedById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@index([category])
}

// ── Experiments ───────────────────────────────────────────────────────────────
// A/B experiment definitions.  Each experiment defines two variant configs
// (variantA / variantB) and the assignment ratio.

model Experiment {
  id          String    @id @default(uuid())
  name        String
  description String?
  key         String    @unique           // slug, used in code: experiments.getVariant(userId, key)
  variantA    Json                        // config payload for variant A (control)
  variantB    Json                        // config payload for variant B (treatment)
  splitRatio  Float     @default(0.5)     // fraction of users assigned to B (0.0–1.0)
  active      Boolean   @default(false)
  startedAt   DateTime?
  endedAt     DateTime?
  createdById String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  assignments ExperimentAssignment[]

  @@index([active])
  @@index([key])
}

// ── Experiment Assignments ────────────────────────────────────────────────────
// Sticky variant assignment per user per experiment.
// Created on first exposure; immutable thereafter (sticky bucketing).

model ExperimentAssignment {
  id           String     @id @default(uuid())
  experimentId String
  experiment   Experiment @relation(fields: [experimentId], references: [id], onDelete: Cascade)
  userId       String
  user         User       @relation("UserExperimentAssignments", fields: [userId], references: [id], onDelete: Cascade)
  variant      String                     // 'A' | 'B'
  assignedAt   DateTime   @default(now())

  @@unique([experimentId, userId])
  @@index([userId])
  @@index([experimentId])
}

// ════════════════════════════════════════════════════════════════════════════
// BEHAVIORAL AI OPTIMIZER — STATE + NUDGE + POLICY
// ════════════════════════════════════════════════════════════════════════════

// ── User Behavioral State ─────────────────────────────────────────────────────
// Stores the current classified state of a user for the optimizer.
// Recomputed on meaningful signal changes; not real-time.
//
// States: newly_onboarded | profile_incomplete | exploring | matching_focused |
//         artifact_building | stuck | feedback_processing | high_momentum |
//         review_ready | readiness_plateaued

model UserBehavioralState {
  id              String    @id @default(uuid())
  userId          String    @unique
  user            User      @relation("UserBehavioralState", fields: [userId], references: [id], onDelete: Cascade)

  // Current classified state
  state           String                          // enum value as string
  previousState   String?                         // last state before transition
  stateChangedAt  DateTime  @default(now())

  // Observable signals snapshot (JSON) — e.g. profilePct, connectionCount, boardCount
  signals         Json      @default("{}")

  // Nudge fatigue tracking
  nudgesSentToday Int       @default(0)
  nudgesSentTotal Int       @default(0)
  lastNudgeAt     DateTime?
  fatigueSince    DateTime?                       // set when nudge_fatigue detected

  // Computed next action recommendation (cached result)
  nextActionKey   String?                         // e.g. 'complete_profile', 'create_board'
  nextActionScore Float?                          // confidence 0–1
  nextActionAt    DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  nudgeLogs       NudgeLog[]

  @@index([state])
  @@index([lastNudgeAt])
}

// ── Nudge Log ─────────────────────────────────────────────────────────────────
// Records every nudge shown to a user, its outcome, and which policy produced it.
// Feeds the optimizer's learning loop.

model NudgeLog {
  id              String    @id @default(uuid())
  userId          String
  user            User      @relation("UserNudgeLogs", fields: [userId], references: [id], onDelete: Cascade)

  stateId         String?
  state           UserBehavioralState? @relation(fields: [stateId], references: [id], onDelete: SetNull)

  // What was shown
  nudgeKey        String                          // e.g. 'complete_profile', 'create_board'
  surface         String                          // 'dashboard' | 'builder' | 'canvas' | 'connections'
  variant         String    @default("control")   // 'control' | 'treatment_A' | 'treatment_B'

  // Outcome
  shown           Boolean   @default(true)
  dismissed       Boolean   @default(false)
  converted       Boolean   @default(false)       // user took the suggested action
  convertedAt     DateTime?
  dismissedAt     DateTime?

  // Metadata
  policyVersion   String?                         // which BehaviorPolicy.version was active
  contextJson     Json?                           // snapshot of signals at time of show

  createdAt       DateTime  @default(now())

  @@index([userId])
  @@index([nudgeKey])
  @@index([surface])
  @@index([createdAt])
  @@index([converted])
}

// ── Behavior Policy ───────────────────────────────────────────────────────────
// Stores tunable parameters for the recommendation engine.
// Admin can edit values; the optimizer reads active policy by version.
// Only ONE policy row should be active at a time.

model BehaviorPolicy {
  id              String    @id @default(uuid())
  version         String    @unique           // e.g. 'v1.0', 'v1.1-test'
  description     String?
  active          Boolean   @default(false)

  // Serialised JSON: all tunable weights, thresholds, timing windows
  // Structure mirrors BehaviorPolicyConfig TypeScript type
  config          Json

  // Experiment linkage (optional: policy variation under A/B test)
  experimentKey   String?

  createdById     String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([active])
}

// ─────────────────────────────────────────────────────────────────────────────
// "Open to" — a quiet signal that feeds matching (packages/shared/src/open-to)
// ─────────────────────────────────────────────────────────────────────────────

enum OpenToVisibility {
  nobody
  verified
  everyone
}

model OpenToSignal {
  userId     String           @id
  kinds      String[]
  visibility OpenToVisibility @default(nobody)
  note       String?
  // Lapses unless renewed, so ranking never leans on forgotten intent.
  expiresAt  DateTime
  updatedAt  DateTime         @updatedAt

  @@index([expiresAt])
}

// ─────────────────────────────────────────────────────────────────────────────
// Warm introductions — consent at every hop (packages/shared/src/intros)
// ─────────────────────────────────────────────────────────────────────────────

enum IntroStatus {
  pending
  forwarded
  declined
  accepted
  not_now
  withdrawn
}

model IntroRequest {
  id             String      @id @default(uuid())
  requesterId    String
  intermediaryId String
  targetId       String
  // The requester's own need card; accepting expresses interest on it.
  cardId         String
  note           String      @db.Text
  forwardNote    String?     @db.Text
  status         IntroStatus @default(pending)
  // How the path ran when it was asked: ['connection', 'mentor', 'cohort'].
  toRequester    String[]    @default([])
  toTarget       String[]    @default([])
  // The ladder thread the target's acceptance opened.
  threadId       String?
  decidedAt      DateTime?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  @@index([requesterId, status])
  @@index([intermediaryId, status])
  @@index([targetId, status])
}

// ─────────────────────────────────────────────────────────────────────────────
// Skills tied to evidence (packages/shared/src/evidence)
// ─────────────────────────────────────────────────────────────────────────────

model SkillEvidence {
  id        String   @id @default(uuid())
  userId    String
  skillName String
  // 'milestone' | 'builder_document' | 'agreement'
  kind      String
  // The milestone, builder document or commitment thread it points to.
  refId     String
  // The title as it was when linked, so a renamed item still reads sensibly.
  label     String
  createdAt DateTime @default(now())

  @@unique([userId, skillName, kind, refId])
  @@index([userId])
}

// ─────────────────────────────────────────────────────────────────────────────
// Co-founder scout: proposals only, it never sends (packages/shared/src/scout)
// ─────────────────────────────────────────────────────────────────────────────

model ScoutBrief {
  userId     String    @id
  role       String
  skills     String[]
  place      String?
  remoteOk   Boolean   @default(true)
  commitment String?
  stage      String?
  note       String?
  active     Boolean   @default(true)
  lastRunAt  DateTime?
  updatedAt  DateTime  @updatedAt
}

enum ScoutProposalStatus {
  proposed
  saved
  dismissed
}

model ScoutProposal {
  id          String              @id @default(uuid())
  userId      String
  candidateId String
  score       Int
  // [{ en, el }] reasons the founder may read
  reasons     Json
  draftNote   String              @db.Text
  status      ScoutProposalStatus @default(proposed)
  createdAt   DateTime            @default(now())
  updatedAt   DateTime            @updatedAt

  // A person is proposed to a founder once; a dismissal is never undone by a run.
  @@unique([userId, candidateId])
  @@index([userId, status])
}
