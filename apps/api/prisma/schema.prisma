// Workspace Builder Extensions — Tech Architecture & Product Requirements
// ─────────────────────────────────────────────────────────────────────────────

model TechArchitecture {
  id               String   @id @default(uuid())
  workspaceId      String   @unique
  workspace        BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)

  // Stack overview
  frontendStack    String[] @default([])   // ["Next.js", "React", "TailwindCSS"]
  backendStack     String[] @default([])   // ["NestJS", "Node.js"]
  databaseStack    String[] @default([])   // ["PostgreSQL", "Redis"]
  infrastructureStack String[] @default([]) // ["AWS", "Vercel", "Docker"]
  aiMlStack        String[] @default([])
  thirdPartyServices String[] @default([]) // ["Stripe", "Twilio", "SendGrid"]

  // Architecture decisions
  architectureType String?            // "monolith", "microservices", "serverless", "modular_monolith"
  deploymentModel  String?            // "cloud", "hybrid", "on_premise"

  // Technical docs
  architectureDiagramUrl String?
  systemDesignNotes String?          @db.Text
  scalingStrategy  String?            @db.Text
  securityNotes    String?            @db.Text

  // Constraints
  technicalDebt    String?            @db.Text
  openTechnicalRisks String?          @db.Text

  // AI context
  aiGeneratedDraft Boolean            @default(false)
  aiPromptUsed     String?

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([workspaceId])
}

model ProductRequirementDoc {
  id               String   @id @default(uuid())
  workspaceId      String
  workspace        BuilderWorkspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  authorId         String
  author           User     @relation("PRDAuthor", fields: [authorId], references: [id], onDelete: Cascade)

  title            String
  version          String             @default("1.0")
  status           String             @default("draft") // "draft", "review", "approved", "deprecated"

  // PRD Content
  problemStatement String?            @db.Text
  targetUsers      String?            @db.Text
  goals            Json?              // [{ goal, metric, target }]
  nonGoals         String?            @db.Text
  assumptions      String?            @db.Text

  // Features
  featuresJson     Json?              // [{ name, priority, description, acceptanceCriteria }]
  userStoriesJson  Json?              // [{ persona, want, soThat }]
  mvpScope         Json?              // Minimal viable feature set

  // Design
  wireframesUrl    String?
  designSystemNotes String?           @db.Text

  // Success metrics
  kpis             Json?              // [{ metric, baseline, target, timeframe }]

  // AI context
  aiGeneratedDraft Boolean            @default(false)

  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@index([workspaceId])
  @@index([authorId])
  @@index([workspaceId, status])
}

