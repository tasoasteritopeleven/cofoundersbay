// ── Builder Review ────────────────────────────────────────────────────────────
// Formal review requests for documents (mentor reviews, advisor feedback)

model BuilderReview {
  id            String              @id @default(uuid())
  documentId    String
  document      BuilderDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
  
  // Review participants
  requestedById String
  requestedBy   User                @relation("BuilderReviewsRequested", fields: [requestedById], references: [id], onDelete: Cascade)
  reviewerId    String
  reviewer      User                @relation("BuilderReviewsAssigned", fields: [reviewerId], references: [id], onDelete: Cascade)
  
  // Review content
  title         String?
  instructions  String?             @db.Text
  
  // Status
  status        BuilderReviewStatus @default(pending)
