// ── Builder Comment ───────────────────────────────────────────────────────────
// Comments on documents

model BuilderComment {
  id            String              @id @default(uuid())
  documentId    String
  document      BuilderDocument     @relation(fields: [documentId], references: [id], onDelete: Cascade)
